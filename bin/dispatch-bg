#!/usr/bin/env bash
# 背景 worker（計畫 dispatcher-bg-plan 第 2／3／6 項）：dispatcher 活在獨立 claude session 裡，
# Router 重啟／/clear／idle-reset 都殺不到它。
# 用法：
#   bin/dispatch-bg <thread> <prompt檔>          新開一張
#   bin/dispatch-bg --thread <thread> <prompt檔> ledger 找同 thread 最新 bg 列的 sessionId 續派，找不到就新開
#   bin/dispatch-bg --from-chat <thread> [--note '<補充>'] --transcript <Router transcript>
#                                                prompt 由 bin/chat-prompt.mjs 從 transcript 抓老闆原話自動寫（11-07 秒回；
#                                                Router 只寫 --from-chat <thread>，--transcript 由 dispatch-gate 補）
#   bin/dispatch-bg --hard [--cwd <repo>] …      同上，worker 用 hard.json（sonnet＋Opus advisor），backend=bg-hard（非 hard 預設 haiku）；
#                                                prompt 第一行要求在 <repo> 開 git worktree（bin/dispatch hard 會帶 --cwd）
# 成功：stdout 印 ledger id（bg-<短id>）；取不到 claude 印的短 id → stderr 原文、ledger 不寫、exit 1。
# WO3-v3：DISPATCH_BG_WORKER=claude（預設，上段行為不變）| hermes → 起 `hermes -p mythos-worker -z "<prompt>"`（detached、
#   stdin=/dev/null、argv 不放 prompt），stdout 串流寫進同一份 result 檔、pid 寫 <sid>.pid，backend=hermes。
# 11-08b（dsh 差距 #1／#3）：hermes worker 的 stdout 只寫 result 檔、stderr 另寫 <result>.err、結束碼寫 <result>.rc；
#   worker 一結束（寫完 rc）立刻在同一個 subshell 觸發一次 dispatch-watch（launchd 每 120 秒留作補漏）。
# 11-08b（dsh 差距 #2）：--cancel <thread>＝停掉該 thread 進行中的 worker（整個行程樹）、ledger 記 cancelled；
#   --interrupt <thread> <新指示檔>＝先 cancel，再以「原需求＋新指示」重派同 thread。
# 兩邊都留 <sid>.rkey，dispatch-watch 從 r-<rk>.result 找回本輪結果檔。
set -u

MYTHOS_DIR="${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CLAUDE="${CLAUDE_BIN:-claude}"
BG_WORKER="${DISPATCH_BG_WORKER:-claude}"
# 11-08 Hermes v0.23：hermes -z 改經 gateway 跑、不再 logging.disable，worker 的 agent.log 原生就有紀錄；hermes-logged 已退役
HERMES="${DISPATCH_BG_HERMES_BIN:-$HOME/.local/bin/hermes}"
case "$BG_WORKER" in claude|hermes) ;; *) echo "DISPATCH_BG_WORKER 只認 claude 或 hermes：$BG_WORKER" >&2; exit 2 ;; esac
hb=''
[ "$BG_WORKER" = hermes ] && hb=1
# 工具白名單（計畫第 1 項）：不帶 mcp__telegram__*，worker 不能直接回使用者
ALLOWED_TOOLS='Bash Read Write Edit Glob Grep'
# 測試守門（F1）：sandbox 非空時 runner（claude 或 hermes）必須也在 sandbox 裡，否則一律拒跑、ledger 不寫
RUNNER="$CLAUDE"; [ -n "$hb" ] && RUNNER="$HERMES"
if [ -n "${MYTHOS_TEST_SANDBOX:-}" ]; then
  case "$RUNNER" in
    "$MYTHOS_TEST_SANDBOX"/*) ;;
    *) echo "測試模式拒跑真 runner" >&2; exit 97 ;;
  esac
fi
. "$ROOT_DIR/bin/lib-ledger.sh"

hard=''
thread=''
thflag=''
tcwd=''
fromchat=''
mode=''
chat_tp=''
chat_note=''
while [ $# -gt 0 ]; do
  case "$1" in
    --hard) hard=1 ;;
    --thread) thread="${2:-}"; thflag=1; shift ;;
    --thread=*) thread="${1#--thread=}"; thflag=1 ;;
    --cwd) tcwd="${2:-}"; shift ;;
    --from-chat) fromchat=1 ;;
    --cancel) mode=cancel ;;
    --interrupt) mode=interrupt ;;
    --transcript) chat_tp="${2:-}"; shift ;;
    --) shift; break ;;
    -) break ;;  # thread=-（bin/dispatch 沒帶 DISPATCH_THREAD）
    -*) echo "不認得的選項：$1" >&2; exit 2 ;;
    *) break ;;
  esac
  shift
done
if [ -n "$fromchat" ]; then
  # 位置參數＝thread；續派寫法 --thread X --from-chat X 兩個都給，要一致（11-07 Codex：原本第二個 X 被當未知參數）
  if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    if [ -z "$thread" ]; then thread="$1"
    elif [ "$1" != "$thread" ]; then echo "--thread ${thread} 與 --from-chat ${1} 不一致" >&2; exit 2; fi
    shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --note) chat_note="${2:-}"; shift ;;
      --transcript) chat_tp="${2:-}"; shift ;;
      *) echo "--from-chat 不認得的參數：$1" >&2; exit 2 ;;
    esac
    shift
  done
  case "$thread" in ''|-|*[!A-Za-z0-9-]*) echo "用法：bin/dispatch-bg --from-chat <thread> [--note '<補充>'] --transcript <檔>" >&2; exit 2 ;; esac
  [ -n "$chat_tp" ] || { echo "--from-chat 缺 --transcript（Router 走 dispatch-gate 會自動補）" >&2; exit 2; }
  gen="$(MYTHOS_DIR="$MYTHOS_DIR" node "$ROOT_DIR/bin/chat-prompt.mjs" "$chat_tp" "$thread" "$chat_note")" || exit 2
  set -- "$thread" "$gen"
fi
# 用法 2 是 [--hard] --thread <thread> <prompt檔>；用法 1 是 [--hard] <thread> <prompt檔>
[ -n "$thread" ] || thread="${1:-}"
prompt="${2:-}"
# --thread 之後只給一個非旗標參數時，它就是 prompt 檔（thread 已由 --thread 給）
if [ -n "$thflag" ] && [ -z "$prompt" ] && [ -f "${1:-}" ]; then prompt="$1"; fi
# Router 的寫法是 --thread <代號> <代號> state/bg/<檔>.md（gate 第 5 項）：兩個代號不一致就拒跑，免得續到別的 thread
if [ -n "$thflag" ] && [ $# -ge 2 ] && [ "$1" != "$thread" ]; then
  echo "--thread $thread 與位置參數 thread $1 不一致" >&2; exit 2
fi
# thread＝- 只准新開（bin/dispatch 沒帶 DISPATCH_THREAD 時）；--thread 續派一定要真代號
[ "$thread" = - ] && [ -z "$thflag" ] && thread=_none
case "$thread" in
  _none) thread=- ;;
  ''|-|*[!A-Za-z0-9-]*) echo "用法：bin/dispatch-bg [--hard] [--thread <代號>] <thread> <prompt檔>" >&2; exit 2 ;;
esac
# 11-08b：--cancel／--interrupt 一定要真 thread（不能靠「同 thread 最新一張」猜）
if [ -n "$mode" ]; then
  [ "$thread" != - ] || { echo "--${mode} 必帶 thread" >&2; exit 2; }
  [ -z "$fromchat" ] || { echo "--${mode} 不能和 --from-chat 並用" >&2; exit 2; }
fi
if [ "$mode" != cancel ]; then
  [ -n "$prompt" ] && [ -f "$prompt" ] || { echo "prompt 檔不存在：${prompt}" >&2; exit 2; }
  case "$prompt" in /*) ;; *) prompt="$PWD/$prompt" ;; esac  # ledger 記絕對路徑（Router 給的是 state/bg/ 相對路徑）
fi
declsrc="$prompt"  # P6：這次 prompt 自己宣告的 repo／readonly（interrupt 會改寫 prompt，所以先記下）

# 11-08b dsh 差距 #2：停該 thread 進行中的 worker。停的動作交 bin/dispatch-cancel（hermes＝殺整個行程樹、claude＝claude stop，
# 兩者都把 ledger 標 cancelled，dispatch-watch 對 cancelled 不 deliver）。必須在取 ledger 鎖之前做（dispatch-cancel 自己拿鎖）。
if [ -n "$mode" ]; then
  CANCEL_BIN="${DISPATCH_CANCEL_BIN:-$ROOT_DIR/bin/dispatch-cancel}"
  TSV0="$MYTHOS_DIR/state/dispatch-jobs.tsv"
  stopped=''
  if [ -f "$TSV0" ]; then
    for aid in $(awk -F'\t' -v th="$thread" '$7==th && ($8=="bg" || $8=="bg-hard" || $8=="hermes") && $5=="pending" {print $1}' "$TSV0"); do
      MYTHOS_DIR="$MYTHOS_DIR" bash "$CANCEL_BIN" "$aid" 9>&- >&2 || { echo "停不掉 ${aid}，未${mode}" >&2; exit 1; }
      stopped="$stopped $aid"
    done
  fi
  # cancel helper 自己拿鎖；停完才鎖住 generation／信箱／佇列，與 followup-direct 互斥。
  ledger_lock || { echo "拿不到 ledger 鎖，未清理取消狀態" >&2; exit 1; }
  trap ledger_unlock EXIT
  trap 'exit 143' TERM HUP INT
  # P4 N02：停掉就換 generation；之後才到的、綁舊 generation 的 follow-up 不消費（dispatch-watch 比對）
  followup_gen_bump "$thread" || exit 1
  # 排在信箱的補充是對舊方向說的；不清掉，dispatch-watch 會在舊 worker 被停後把它當新單派出去
  rm -rf "$MYTHOS_DIR/state/mailbox/$thread" || exit 1
  # 11-08（G11）：排隊中的（hermes 上限滿時排的）也一起丟掉；每項第一欄是 thread
  qn=''
  for qf in $(awk -F'\t' -v th="$thread" '$1==th {print FILENAME}' "$MYTHOS_DIR"/state/hermes-queue/* 2>/dev/null); do
    if [ -f "$qf" ]; then
      rm -f -- "$qf" || exit 1
      qn="$qn $qf"
    fi
  done
  ledger_unlock
  trap - EXIT TERM HUP INT
  [ -n "$qn" ] && echo "已丟掉排隊項：$(for f in $qn; do printf '%s ' "${f##*/}"; done)"
  if [ "$mode" = cancel ]; then
    if [ -n "$stopped" ]; then echo "已停${stopped}"; else echo "thread ${thread} 沒有進行中的事"; fi
    exit 0
  fi
  # interrupt：原需求取 ledger 該 thread 最新一張的 prompt 檔（沒有就只用新指示）
  orig=''
  [ -f "$TSV0" ] && orig="$(awk -F'\t' -v th="$thread" '$7==th && ($8=="bg" || $8=="bg-hard" || $8=="hermes") {p=$3} END{print p}' "$TSV0")"
  # P4 G08：前情＝上一輪（被停的那張）結果檔前 N 字（MYTHOS_PREV_RESULT_CHARS，預設 600）；沒有結果就不附
  prev_sum=''
  if [ -f "$TSV0" ]; then
    prev_id="$(awk -F'\t' -v th="$thread" '$7==th && ($8=="bg" || $8=="bg-hard" || $8=="hermes") {id=$1} END{print id}' "$TSV0")"
    prev_sid="${prev_id#bg-}"; prev_rf="$MYTHOS_DIR/state/bg/$prev_sid.result"
    prev_rk="$(tr -d '[:space:]' < "$MYTHOS_DIR/state/bg/$prev_sid.rkey" 2>/dev/null)"
    case "$prev_rk" in ''|*[!A-Za-z0-9._-]*) ;; *) [ -s "$MYTHOS_DIR/state/bg/r-$prev_rk.result" ] && prev_rf="$MYTHOS_DIR/state/bg/r-$prev_rk.result" ;; esac
    if [ -n "$prev_sid" ] && [ -s "$prev_rf" ]; then
      prev_sum="$(N="${MYTHOS_PREV_RESULT_CHARS:-600}" perl -CSD -0777 -ne 'print substr($_, 0, $ENV{N})' < "$prev_rf" 2>/dev/null)"
    fi
  fi
  mkdir -p "$MYTHOS_DIR/state/bg" || exit 1
  ipf="$MYTHOS_DIR/state/bg/$thread-interrupt-$(date +%s)-$$.md"
  {
    if [ -n "$orig" ] && [ -f "$orig" ]; then
      printf '【原需求（Ether 先前交辦，已被打斷、舊的做法作廢）】\n'
      cat "$orig"
      if [ -n "$prev_sum" ]; then
        printf '\n【上一輪結果摘要（被打斷前的結果，前 %s 字；僅供參考）】\n%s\n' "${MYTHOS_PREV_RESULT_CHARS:-600}" "$prev_sum"
      fi
      printf '\n【Ether 改口，以這段新指示為準】\n'
    fi
    cat "$prompt"
  } > "$ipf" || exit 1
  prompt="$ipf"
  thflag=1
fi
# P6 追問繼承原 meta：續派（--thread／--interrupt）的 prompt 自己宣告了 repo 就用它，沒宣告沿用同 thread 最近一張 job 的 repo／readonly。
# 寫在 prompt.meta.json，之後排程（hermes_repo_busy）、信箱、hermes 佇列都只讀這份。
if [ "$thread" != - ] && [ -f "$prompt" ]; then
  inh=''
  [ -f "$MYTHOS_DIR/state/dispatch-jobs.tsv" ] && inh="$(awk -F'\t' -v th="$thread" '$7==th && ($8=="bg" || $8=="bg-hard" || $8=="hermes") {p=$3} END{print p}' "$MYTHOS_DIR/state/dispatch-jobs.tsv")"
  # 一般入口的無 meta prompt：開頭標頭原本就是正式宣告，先遷入 meta。
  # interrupt 的新指示屬正文，不得把正文標頭升成宣告。
  if [ "$mode" != interrupt ] && [ ! -f "$declsrc.meta.json" ]; then
    prompt_meta_inherit "$declsrc" --legacy-first "$declsrc" || exit 1
  fi
  prompt_meta_inherit "$prompt" --legacy-first "$inh" "$declsrc" || { echo "寫 ${prompt}.meta.json 失敗" >&2; exit 1; }
fi

WORKER_DIR="${MYTHOS_WORKER_DIR:-$HOME/bots/mythos-worker}"
[ -d "$WORKER_DIR" ] || { echo "worker 目錄不存在：${WORKER_DIR}（跑 run.sh 會從 router/worker 同步）" >&2; exit 1; }
mkdir -p "$MYTHOS_DIR/state/bg"

# 11-07：保留、信箱與 launcher 交接共用 ledger 鎖；啟動期間也持鎖，另一呼叫不能搶開。
# worker 不繼承 fd 9。鎖失敗時尚未啟動任何 worker。
ledger_lock || { echo "拿不到 ledger 鎖，未啟動 worker" >&2; exit 1; }
reserve="$MYTHOS_DIR/state/bg/.reserve-$thread"
cleanup_bg() { [ -z "$reserve" ] || rm -f "$reserve"; ledger_unlock; }
trap cleanup_bg EXIT
trap 'exit 143' TERM HUP INT
printf '%s\n' "$$" > "$reserve" || exit 1
# 自癒／信箱重送都帶穩定 eid；先查相同 prompt 的已登錄列，跨 crash 不再起第二個。
eid="${DISPATCH_BG_EID:-}"
case "$eid" in .*|*[!A-Za-z0-9_.-]*) echo "不合法的重派 eid" >&2; exit 2 ;; esac
if [ -n "$eid" ] && [ -f "$MYTHOS_DIR/state/dispatch-jobs.tsv" ]; then
  prior="$(awk -F'\t' -v th="$thread" -v p="$prompt" '$7==th && $3==p && ($8=="bg" || $8=="bg-hard" || $8=="hermes") {id=$1} END{print id}' "$MYTHOS_DIR/state/dispatch-jobs.tsv")"
  if [ -n "$prior" ]; then echo "$prior"; exit 0; fi
fi
if [ "$thread" != - ] && [ -f "$MYTHOS_DIR/state/dispatch-jobs.tsv" ]; then
  active="$(awk -F'\t' -v th="$thread" '$7==th && ($8=="bg" || $8=="bg-hard" || $8=="hermes") {id=$1; st=$5} END{if(st=="pending") print id}' "$MYTHOS_DIR/state/dispatch-jobs.tsv")"
  # hermes 沒有 claude agents 可問：同 thread 還在跑就一律排信箱（pid 由 dispatch-watch 判斷，這裡不猜）
  if [ -n "$active" ] && { [ -n "$hb" ] || ! jq -e --arg id "$active" 'select(.job_id==$id and (.status=="PASS" or .status=="FAIL" or .status=="TIMEOUT"))' "$MYTHOS_DIR/state/events.jsonl" >/dev/null 2>&1; }; then
    # ledger 尚未收尾時，以 agents 確認終態；查不到一律先排隊，避免未知狀態又開一個。
    if command -v timeout >/dev/null 2>&1; then CHECK_TO=(timeout -k 5 20)
    elif command -v gtimeout >/dev/null 2>&1; then CHECK_TO=(gtimeout -k 5 20)
    else CHECK_TO=()
    fi
    ast='queued'
    if [ -z "$hb" ]; then
      ast="$(${CHECK_TO[@]+"${CHECK_TO[@]}"} "$CLAUDE" agents --json --all </dev/null 9>&- 2>/dev/null | jq -r --arg s "${active#bg-}" '[.[]? | select((.sessionId // .id // "") | startswith($s)) | .state][0] // "unknown"' 2>/dev/null)"
    fi
    case "$ast" in done|completed|exited|stopped|failed|error|killed) ;;
      *)
        mb="$MYTHOS_DIR/state/mailbox/$thread"
        mkdir -p "$mb" || exit 1
        if [ -n "$eid" ] && [ -f "$mb/$eid.md" ]; then echo "$active"; exit 0; fi
        tmp="$(mktemp "$mb/.incoming.XXXXXX")" || exit 1
        cat "$prompt" > "$tmp" || { rm -f "$tmp"; exit 1; }
        dest="$mb/${eid:-${tmp##*.}}.md"
        mv "$tmp" "$dest" || exit 1
        # P6：信箱訊息帶著自己的 meta，批次組裝時才能看見它宣告的 repo
        [ -f "$prompt.meta.json" ] && cp "$prompt.meta.json" "$dest.meta.json"
        "${NODE_BIN:-node}" "$ROOT_DIR/bin/lib-request.mjs" log "$MYTHOS_DIR" queued "$prompt" "$active" 9>&- || echo "信箱已存，但 request 紀錄寫入失敗" >&2
        echo "thread ${thread} 已有 worker，訊息已存信箱" >&2
        echo "$active"; exit 0 ;;
    esac
  fi
  # ledger 還掛 pending 但 worker 已終止：照 11-06 去重改續派；最新一張已收尾就照 Router 的選擇新開（續接會讓 context 越滾越大）。
  [ -n "$active" ] && [ -z "$hard" ] && thflag=1
fi

resume=''
if [ -n "$thflag" ] && [ -f "$MYTHOS_DIR/state/dispatch-jobs.tsv" ]; then
  # 11-08 audit#2：resume 刻意不納入 hermes 列——hermes sid 是隨機碼、不是 claude session，拿去 --resume 會失敗。
  resume="$(awk -F'\t' -v th="$thread" '
    { if (NF < 8) $8 = $8 }
    ($7 == th && ($8 == "bg" || $8 == "bg-hard")) { sid = substr($1, 4) }
    END { print sid }' "$MYTHOS_DIR/state/dispatch-jobs.tsv" 2>/dev/null)"
fi
# --resume 要完整 sessionId（11-04 實測）：只給 8 碼短 id 時 claude 起一個「copy」，停在 working、不寫 transcript，
# watchlist-watch 兩次續派都這樣卡到 STALL。ledger 只存短 id，這裡向 claude agents 換回完整 id；換不到就新開，不硬續。
if [ -n "$resume" ] && [ -z "$hb" ]; then
  if command -v timeout >/dev/null 2>&1; then TO=(timeout -k 5 20)
  elif command -v gtimeout >/dev/null 2>&1; then TO=(gtimeout -k 5 20)
  else TO=()
  fi
  full="$(${TO[@]+"${TO[@]}"} "$CLAUDE" agents --json --all </dev/null 9>&- 2>/dev/null | jq -r --arg s "$resume" \
    '[.[]? | .sessionId // empty | select(startswith($s + "-"))][0] // empty' 2>/dev/null)"
  if [ -n "$full" ]; then
    resume="$full"
  else
    echo "找不到 ${resume} 的完整 sessionId（claude agents 沒列出），改開新 session" >&2
    resume=''
  fi
fi
# 11-08（G11）：hermes worker 同時開工上限 MYTHOS_HERMES_SLOTS（預設 3）。達上限→不寫 ledger、不起行程，
# 改排 state/hermes-queue/（一筆一檔，<epoch>-<pid> 保 FIFO；內容含 thread 與 prompt 路徑），dispatch-watch 有空位再照原參數派。
# 仍在上面 hold 著的 ledger 鎖內數，兩個呼叫不會同時看到有空位。同一 thread 的續派已在上面進信箱，不受此限。
if [ -n "$hb" ]; then
  slots="${MYTHOS_HERMES_SLOTS:-3}"
  case "$slots" in ''|*[!0-9]*) slots=3 ;; esac
  # ponytail: 存活數＝ledger pending 列；worker 果真死掉時要等 dispatch-watch 一輪收尾才釋放。
  nlive=0
  [ -f "$MYTHOS_DIR/state/dispatch-jobs.tsv" ] && nlive="$(awk -F'\t' '$5=="pending" && $8=="hermes"' "$MYTHOS_DIR/state/dispatch-jobs.tsv" | wc -l | tr -d ' ')"
  # P4 N03：宣告了 repo 的寫入任務，同 repo 已有 pending 寫入列就一樣排隊（唯讀不擋；沒宣告＝不查）。
  # 持 ledger 鎖查，兩個同 repo 的派工不會都看到「沒人寫」。
  wrepo="$(prompt_repo_of "$prompt")"
  why=''
  if [ "$nlive" -ge "$slots" ]; then why="hermes worker ${nlive}/${slots} 都在跑"
  elif [ -n "$wrepo" ] && [ -z "$(prompt_readonly_of "$prompt")" ] && hermes_repo_busy "$wrepo"; then why="repo ${wrepo} 已有寫入任務在跑"
  fi
  if [ -n "$why" ]; then
    qd="$MYTHOS_DIR/state/hermes-queue"
    mkdir -p "$qd" || exit 1
    qf="$qd/$(date +%s)-$$"
    printf '%s\t%s\n' "$thread" "$prompt" > "$qf.tmp" && mv -f "$qf.tmp" "$qf" || { rm -f "$qf.tmp"; exit 1; }
    echo "已排隊：${why}，thread ${thread} 排入佇列 ${qf##*/}" >&2
    echo "queued-${qf##*/}"
    exit 0
  fi
fi

# 11-07 使用者定：worker 預設 haiku，不勝任就派 O（bin/dispatch）或 opencode 免費，不升 Claude 模型；
# bg-hard 是明設 DISPATCH_HARD_BACKEND=bg 才走的付費路，維持 sonnet。DISPATCH_BG_MODEL 覆寫非 hard worker 的模型。
model="${DISPATCH_BG_MODEL:-haiku}"
[ -n "$hard" ] && model=sonnet
args=(--bg --model "$model" --allowedTools "$ALLOWED_TOOLS" --name "mythos:$thread")
backend=bg
settings=''
if [ -n "$hb" ]; then
  backend=hermes
elif [ -n "$hard" ]; then
  settings="$WORKER_DIR/.claude/hard.json"
  [ -f "$settings" ] || { echo "找不到 $settings" >&2; exit 1; }
  args+=(--settings "$settings")
  backend=bg-hard
fi
# 11-06 瘦身：非 hard worker 不載入 skill 清單（實測少約 8K 新輸入）；DISPATCH_BG_KEEP_SKILLS=1 關閉。
# 復原：cp state/backups-20261106-slim/dispatch-bg.bak-20261106-slim bin/dispatch-bg
[ -z "$hb" ] && [ -z "$hard" ] && [ -z "${DISPATCH_BG_KEEP_SKILLS:-}" ] && args+=(--disable-slash-commands)
[ -n "$resume" ] && args+=(--resume "$resume")
# 11-07（bg-97f17c4d）：本輪專用結果檔由這裡指定，不讓 worker 自己猜短 id；續派 worker 才不會把結果寫回上一輪的檔。
# watch 從 <sid>.rkey 找 r-<rk>.result。本輪專用路徑也寫進給 worker 的 prompt 開頭。
rk="$(date +%s)-$$"
rfbody="$MYTHOS_DIR/state/bg/r-$rk.result"
rfline="結果檔：${rfbody}（本輪專用，不沿用前幾輪的檔名）"
insert_after_first() { # body line → 插在第一行 thread= 之後（跟 tier 同一處理方式），沒有 thread= 就放最前面
  case "$1" in
    thread=*) printf '%s\n%s\n%s' "${1%%$'\n'*}" "$2" "${1#*$'\n'}" ;;
    *) printf '%s\n%s' "$2" "$1" ;;
  esac
}
# 最後一個參數才是 prompt 內容
body="$(cat "$prompt")"
body="$(insert_after_first "$body" "$rfline")"
# 11-07 判難度前移：haiku worker 只做勝任的事，所以難度由本機 Laya（triage，零 token、約 3 秒）先判好寫進 prompt，
# worker 只能往上改不能往下改。找不到 triage 一律當 mid（不讓 haiku 自己動手）。
if [ -z "$hard" ]; then
  TRIAGE="${DISPATCH_GATE_TRIAGE:-$(command -v triage || echo "$HOME/dev/dispatch-router/bin/triage")}"
  tier=''
  [ -x "$TRIAGE" ] && tier="$("$TRIAGE" "$prompt" 2>/dev/null </dev/null 9>&- | tail -1 | tr -d '[:space:]')"
  case "$tier" in easy|mid|hard) ;; *) tier=mid ;; esac
  tl="tier=${tier}（本機判定；只能往上改，不能往下改）"
  body="$(insert_after_first "$body" "$tl")"  # 第一行 thread= 照舊留第一行
fi
if [ -n "$hard" ]; then
  # bg-hard 一律在 worktree 跑（計畫第 6 項）：prompt 第一行就要求 git worktree add，不直接改現役 repo
  repo="${tcwd:-<要改的 repo>}"
  wt="${TMPDIR:-/tmp}/bg-hard-$(date +%s)-$$"
  body="第一步：git -C '$repo' worktree add -b bg-hard/$(basename "$wt") '$wt'；之後所有改動只在 ${wt} 裡做，不直接改 ${repo}，不 merge、不 push，結果寫 worktree 路徑與 branch。
定方向、卡關、宣告完成前各叫一次 advisor。最後一步寫 ${rfbody}。

$body"
fi
# 11-07 帳本機械計數：prompt 內容含「單／派工／工單／未解／未收尾／dcq／帳本／卡住」任一關鍵字時，
# body 尾端附 bin/ledger-status 的前 15 行；worker 轉述單數、時間一律照這段，不自己數帳本或換算 epoch。
# ledger-status 失敗（或沒輸出）就不附，不擋派工。
if printf '%s' "$body" | grep -qE '單|派工|工單|未解|未收尾|dcq|帳本|卡住'; then
  ledger="$(MYTHOS_DIR="$MYTHOS_DIR" DCQ_HOME="${DCQ_HOME:-$HOME/.dcq}" "$ROOT_DIR/bin/ledger-status" 2>/dev/null)"
  if [ -n "$ledger" ]; then
    ledger="$(printf '%s\n%s' '【帳本現況（bin/ledger-status 機械計數；回報單數、時間一律照這段，不要自己數或換算 epoch）】' "$(printf '%s\n' "$ledger" | head -15)")"
    body="$body
$ledger"
  fi
fi
# 11-08：摘要直發使用者，說話規則直接套 Genie 本體（bin/genie-context，跟著 Claude Code 裝的版本走；Router 外掛共用）；
# 找不到或失敗就不附，不擋派工。
genie="$(MYTHOS_DIR="$MYTHOS_DIR" "$ROOT_DIR/bin/genie-context" 2>/dev/null </dev/null 9>&-)"
[ -n "$genie" ] && body="$body

【寫「摘要：」段時照這段說話規則（Genie）】
$genie"
args+=("$body")
"${NODE_BIN:-node}" "$ROOT_DIR/bin/lib-request.mjs" log "$MYTHOS_DIR" queued "$prompt" "" 9>&- || echo "request 紀錄寫入失敗（不擋派工）" >&2
if [ -n "$hb" ]; then
  # hermes -z 一次跑完印結果，沒有 session 短 id 可續派、可 stop：id 用隨機 8 碼，靠 <sid>.pid 判存活。
  # 續派＝新開一輪（同 thread，「同 thread 還在跑」在上面一律排信箱）。stdout 直接寫 result 檔，檔案一定存在。
  # ponytail: hermes 停不掉（寫 ledger 失敗只能殺這個 pid 這一支）；續派不帶前情。
  : > "$rfbody" || { echo "result 檔開不了：$rfbody" >&2; exit 1; }
  sid="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  # 11-08b #1：stdout 只進 result、stderr 進 <result>.err、結束碼進 <result>.rc（原子寫），dispatch-watch 以 rc／stdout 判完成。
  # 11-08b #3：worker 結束、rc 落地後立刻觸發一次 dispatch-watch（等 dispatch-bg 把 ledger 列與 pid 檔登完；dispatch-watch 以 rc 檔優先於 pid 判完成）。
  # subshell 自己的 stdin／stdout／stderr 也指到 /dev/null：不然它會握著呼叫端的 $() 管道直到 worker 結束（mythos_dispatch 的 subprocess 就等不到 EOF）。
  WATCH_BIN="${DISPATCH_WATCH_BIN:-$ROOT_DIR/bin/dispatch-watch}"
  trig=1
  [ "${DISPATCH_BG_NO_TRIGGER:-}" = 1 ] && trig=''
  if [ -n "${MYTHOS_TEST_SANDBOX:-}" ]; then
    case "$WATCH_BIN" in "$MYTHOS_TEST_SANDBOX"/*) ;; *) trig='' ;; esac  # 測試守門：不在 sandbox 的 watch 不觸發
  fi
  (
    cd "$WORKER_DIR" && "$HERMES" -p mythos-worker -z "$body" </dev/null >"$rfbody" 2>"$rfbody.err" 9>&-
    wrc=$?
    printf '%s\n' "$wrc" > "$rfbody.rc.tmp" && mv -f "$rfbody.rc.tmp" "$rfbody.rc"
    if [ -n "$trig" ]; then
      n=0; while [ ! -f "$MYTHOS_DIR/state/bg/$sid.pid" ] && [ "$n" -lt 300 ]; do sleep 0.1; n=$((n + 1)); done
      MYTHOS_DIR="$MYTHOS_DIR" bash "$WATCH_BIN" </dev/null >/dev/null 2>&1 9>&-
    fi
  ) </dev/null >/dev/null 2>&1 9>&- &  # 11-08：subshell 本身也要關 fd 9，否則 ledger 鎖會被它握到 worker 結束（dispatch-watch 拿不到鎖）
  hpid=$!
else
# 9>&-：claude 會活過本行程，不能繼承 ledger 鎖
out="$(cd "$WORKER_DIR" && "$CLAUDE" "${args[@]}" 2>&1 9>&-)"
rc=$?
# 先認「backgrounded · <短id> ·」那行：續派時 claude 會先印「note: session <原id> is already running … copy as <新id>」，
# 抓第一個 hex 會記成原 session（11-04 實測）。沒有那行（舊版輸出）才退回第一個 hex。
sid="$(printf '%s\n' "$out" | sed -n 's/.*backgrounded · \([0-9a-f]\{8\}\).*/\1/p' | head -1)"
[ -n "$sid" ] || sid="$(printf '%s\n' "$out" | grep -oE '[0-9a-f]{8}' | head -1)"
if [ "$rc" != 0 ] || [ -z "$sid" ]; then
  printf '%s\n' "$out" >&2
  echo "claude --bg 沒印出短 id（exit ${rc}），未登錄" >&2
  exit 1
fi
fi

id="bg-$sid"
# 第 6 欄：只有 --hard 記目標 repo（dispatch-retry 拿它重派 worktree）；非 hard 留 worker 目錄
[ -n "$hard" ] || tcwd="$WORKER_DIR"
row="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$id" "$([ -n "$hard" ] && echo hard || echo mid)" "$prompt" "$(date +%s)" pending "${tcwd:-$WORKER_DIR}" "$thread" "$backend")"
# F2：登錄失敗要收掉已啟動的 worker，不然 Router fallback 再派一次就有兩個 worker
stop_worker() { # 原因
  if [ -n "$hb" ]; then
    pkill -P "$hpid" 2>/dev/null; kill "$hpid" 2>/dev/null; echo "${1}；已停止 worker ${sid}（hermes）" >&2; return
  fi
  if "$CLAUDE" stop "$sid" </dev/null 9>&- >/dev/null 2>&1; then
    echo "${1}；已停止 worker ${sid}" >&2
  else
    echo "${1}；停止 worker 失敗 ${sid}" >&2
  fi
}
if ! printf '%s\n' "$row" >> "$MYTHOS_DIR/state/dispatch-jobs.tsv"; then
  stop_worker "寫 ledger 失敗：${id}"; exit 1
fi
# 11-07 續派：ledger 寫成後才留 rkey，dispatch-watch 從它找本輪結果檔
printf '%s\n' "$rk" > "$MYTHOS_DIR/state/bg/$sid.rkey" || echo "rkey 寫入失敗：$sid" >&2
# 11-08 差距 #6：並記 pid 的開機時間（ps lstart，與 dispatch-cancel deep 分支逐字比對），pid 被重用時取消端才不會殺錯。
[ -n "$hb" ] && {
  printf '%s\n' "$hpid" > "$MYTHOS_DIR/state/bg/$sid.pid" || echo "pid 寫入失敗：$sid" >&2
  printf '%s\n' "$(ps -o lstart= -p "$hpid" 2>/dev/null)" > "$MYTHOS_DIR/state/bg/$sid.pid_start" || echo "pid_start 寫入失敗：$sid" >&2
}
"${NODE_BIN:-node}" "$ROOT_DIR/bin/lib-request.mjs" log "$MYTHOS_DIR" worker-start "$prompt" "$id" 9>&- || echo "worker 已登錄，但 request 紀錄寫入失敗" >&2
rm -f "$reserve"; reserve=''
ledger_unlock
echo "$id"
