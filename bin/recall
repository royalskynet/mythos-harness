#!/usr/bin/env python3
"""記憶快查（11-07 使用者定）：Router 自己查主 session 記憶、自己答，不派 dispatcher、不叫 LLM。
用法：bin/recall '<關鍵字>'   一次查三處，各回索引
      bin/recall --obs <id>    展開 claude-mem 一筆
      bin/recall --fix <id>    展開 fixindex 一筆
      bin/recall '<關鍵字>' --ask '<原問題>'   查完交 bin/brief-answer 寫成秘書口吻直送 Telegram，stdout 只回「已直送」（11-07 秒回）
- claude-mem：只打 worker 的 HTTP GET /api/search、/api/observation/<id>（唯讀）；不載 plugin，Mythos 對話不寫進 claude-mem。
  紀錄多是英文標題：中文詞組沒命中就逐詞再查。
- fixindex find --spill；主 session memory 目錄（MEMORY.md、feedback/project/reference、state/）逐行比對。
- 全程本機，不出機，所以不過 PII 閘。
- 三個來源都是選用：沒裝／沒開的自動略過；RECALL_SOURCES=mem,fix,md 挑要用哪幾個（預設全部）。
exit：0 有結果｜1 都查不到｜2 用法｜6 沒有任何可用來源（呼叫端改派 dispatcher）
"""
import json, os, re, shutil, subprocess, sys, urllib.parse, urllib.request

MEM_URL = os.environ.get("RECALL_MEM_URL") or "http://127.0.0.1:37701"
FIXINDEX = os.environ.get("RECALL_FIXINDEX") or shutil.which("fixindex") or os.path.expanduser("~/.local/bin/fixindex")
FIX_DIR = os.environ.get("RECALL_FIX_DIR") or os.path.expanduser("~/dev/fix-store/fixes")
# 主 session（cwd＝家目錄）的 Claude Code auto-memory：~/.claude/projects/<家目錄路徑 / . 換成 ->/memory
MEM_DIR = os.environ.get("RECALL_MEM_DIR") or os.path.join(
    os.path.expanduser("~/.claude/projects"), re.sub(r"[/.]", "-", os.path.expanduser("~")), "memory")
SOURCES = [x.strip() for x in (os.environ.get("RECALL_SOURCES") or "mem,fix,md").split(",") if x.strip()]
LIMIT = 5


def get(path):
    try:
        with urllib.request.urlopen(MEM_URL + path, timeout=8) as r:
            return json.load(r)
    except Exception as e:
        return {"_err": str(e)}


def available():
    ok = []
    if "mem" in SOURCES and get("/api/health").get("status") == "ok":
        ok.append("mem")
    if "fix" in SOURCES and os.access(FIXINDEX, os.X_OK) and os.path.isdir(FIX_DIR):
        ok.append("fix")
    if "md" in SOURCES and os.path.isdir(MEM_DIR):
        ok.append("md")
    return ok


def mem_search(q):
    terms = [q] + ([t for t in q.split() if len(t) > 1] if " " in q.strip() else [])
    seen, rows, err = set(), [], None
    for t in terms:
        d = get(f"/api/search?format=json&limit={LIMIT}&query={urllib.parse.quote(t)}")
        err = err or d.get("_err")
        for o in d.get("observations") or []:
            if o.get("id") not in seen:
                seen.add(o.get("id"))
                rows.append(f"  #{o.get('id')} {str(o.get('created_at', ''))[:10]} {o.get('title', '')}")
        if rows:
            break
    return rows[:LIMIT], err


def fix_search(q):
    try:
        out = subprocess.run([FIXINDEX, "find", q, "--spill", "--limit", "20"], capture_output=True, text=True, timeout=30).stdout
    except Exception as e:
        return [f"  （fixindex 失敗：{e}）"]
    # find 是語意排序、分數正規化，亂打也回滿 → 只留內文真的含全部關鍵字的條目
    terms = [t.lower() for t in q.split() if t]
    rows = []
    for l in out.splitlines():
        m = re.match(r"\s+\d+#\d+\s+\[\w+\]\s+(\S+\.md)", l)
        if not m:
            continue
        try:
            body = open(os.path.join(FIX_DIR, m.group(1)), encoding="utf-8", errors="replace").read().lower()
        except OSError:
            continue
        if all(t in body for t in terms):
            rows.append(l.rstrip()[:200])
    return rows[:LIMIT]


def memdir_search(q):
    terms = [t.lower() for t in q.split() if t]
    rows = []
    for root, _, files in os.walk(MEM_DIR):
        for f in sorted(files):
            if not f.endswith(".md"):
                continue
            p = os.path.join(root, f)
            try:
                lines = open(p, encoding="utf-8", errors="replace").read().splitlines()
            except OSError:
                continue
            hits = [l.strip() for l in lines if all(t in l.lower() for t in terms)]
            if hits:
                rows.append(f"  {os.path.relpath(p, MEM_DIR)}：{hits[0][:160]}")
    return rows[:LIMIT * 2]


def main(argv):
    ok = available()
    if len(argv) == 2 and argv[0] in ("--obs", "--fix") and argv[1].isdigit() and \
            {"--obs": "mem", "--fix": "fix"}[argv[0]] not in ok:
        print(f"{argv[0][2:]} 來源沒裝或沒開，改派 dispatcher", file=sys.stderr)
        return 6
    if len(argv) == 2 and argv[0] == "--obs" and argv[1].isdigit():
        d = get(f"/api/observation/{argv[1]}")
        if d.get("_err") or not d.get("id"):
            print(f"claude-mem 查不到 #{argv[1]}：{d.get('_err', '')}")
            return 1
        facts = d.get("facts")
        facts = json.loads(facts) if isinstance(facts, str) and facts.startswith("[") else facts or []
        print(f"#{d['id']} {str(d.get('created_at', ''))[:10]} [{d.get('project')}] {d.get('title')}\n{d.get('narrative') or d.get('text') or ''}")
        for x in facts[:8]:
            print(f"- {x}")
        return 0
    if len(argv) == 2 and argv[0] == "--fix" and argv[1].isdigit():
        r = subprocess.run([FIXINDEX, "show", argv[1]], capture_output=True, text=True, timeout=30)
        print(r.stdout[:3000] or f"fixindex 查不到 {argv[1]}")
        return 0 if r.stdout else 1
    q = " ".join(argv).strip()
    if not q or q.startswith("-"):
        print(__doc__, file=sys.stderr)
        return 2
    if not ok:
        print(f"沒有可用的記憶來源（RECALL_SOURCES={','.join(SOURCES)}；claude-mem worker／fixindex／{MEM_DIR} 都不在），改派 dispatcher", file=sys.stderr)
        return 6
    mem = fix = md = []
    if "mem" in ok:
        mem, err = mem_search(q)
        print(f"## claude-mem（展開：bin/recall --obs <id>）" + (f"｜連線失敗：{err}" if err and not mem else ""))
        print("\n".join(mem) or "  （無）")
    if "fix" in ok:
        fix = fix_search(q)
        print("## fixindex（展開：bin/recall --fix <id>）")
        print("\n".join(fix) or "  （無）")
    if "md" in ok:
        md = memdir_search(q)
        print(f"## memory 目錄 {MEM_DIR}")
        print("\n".join(md) or "  （無）")
    skipped = [x for x in SOURCES if x not in ok]
    if skipped:
        print(f"（略過，沒裝或沒開：{','.join(skipped)}）")
    return 0 if (mem or fix or md) else 1


BRIEF = os.environ.get("RECALL_BRIEF") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "brief-answer")


def ask_main(argv):
    """--ask：結果（含查不到）交 brief-answer 直送；送不出去或沒來源（6）就照舊印給呼叫端。"""
    import contextlib, io
    i = argv.index("--ask")
    q, rest = (argv[i + 1] if i + 1 < len(argv) else ""), argv[:i] + argv[i + 2:]
    if not q.strip():
        print(__doc__, file=sys.stderr)
        return 2
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        rc = main(rest)
    if rc in (0, 1):
        material = buf.getvalue() if rc == 0 else f"記憶三處都查不到「{' '.join(rest)}」"
        # 查不到用固定句子（--not-found），不花模型；brief 8＝送出結果不明，可能已到，不再交 Router 轉述
        brc = subprocess.run([BRIEF, "--kind", "recall", "--q", q] + ([] if rc == 0 else ["--not-found"]),
                             input=material, text=True).returncode
        if brc in (0, 8):
            print("已直送使用者（秘書口吻），不用再 reply。" if brc == 0 else "已直送使用者（送出結果不明，可能已到），不用再 reply。")
            return 0
    sys.stdout.write(buf.getvalue())
    return rc


def selftest():
    global MEM_URL, MEM_DIR
    import tempfile
    d = tempfile.mkdtemp()
    open(os.path.join(d, "a.md"), "w").write("x\n訂閱＝花錢 Go 月費\n")
    MEM_DIR, MEM_URL = d, "http://127.0.0.1:1"
    assert memdir_search("訂閱 月費") == ["  a.md：訂閱＝花錢 Go 月費"], memdir_search("訂閱 月費")
    assert memdir_search("訂閱 不存在") == []
    rows, err = mem_search("x y")
    assert rows == [] and err, (rows, err)
    global FIXINDEX, FIX_DIR
    open(os.path.join(d, "11.md"), "w").write("加輪 授權")
    open(os.path.join(d, "fake"), "w").write("#!/bin/sh\necho '  11#1  [U] 11.md  t'\necho '  12#1  [U] 12.md  t'\n")
    os.chmod(os.path.join(d, "fake"), 0o755)
    FIXINDEX, FIX_DIR = os.path.join(d, "fake"), d
    assert fix_search("加輪") == ["  11#1  [U] 11.md  t"], fix_search("加輪")
    assert fix_search("不存在") == []
    assert main([]) == 2 and main(["--obs", "abc"]) == 2
    # 選用來源：claude-mem 不通（MEM_URL 指向 :1）→ 只用其餘；全部不在 → 6
    global SOURCES
    assert available() == ["fix", "md"], available()
    assert main(["--obs", "1"]) == 6
    assert main(["加輪"]) == 0
    MEM_DIR, FIXINDEX = os.path.join(d, "nope"), os.path.join(d, "nope")
    assert available() == [] and main(["加輪"]) == 6
    SOURCES = ["md"]
    MEM_DIR = d
    assert available() == ["md"] and main(["加輪"]) == 0 and main(["不存在"]) == 1
    # --ask：有結果／查不到都交 brief-answer；brief 失敗就把結果印回呼叫端
    global BRIEF
    log = os.path.join(d, "brief.log")
    open(os.path.join(d, "brief"), "w").write(f"#!/bin/sh\necho \"$*\" >> {log}\ncat >> {log}\nexit ${{BRIEF_RC:-0}}\n")
    os.chmod(os.path.join(d, "brief"), 0o755)
    BRIEF = os.path.join(d, "brief")
    assert ask_main(["加輪", "--ask", "加輪怎麼用？"]) == 0
    assert ask_main(["不存在", "--ask", "那個呢"]) == 0
    got = open(log).read()
    assert "--kind recall --q 加輪怎麼用？" in got and "11.md" in got and "查不到「不存在」" in got, got
    assert "--q 那個呢 --not-found" in got and "--q 加輪怎麼用？ --not-found" not in got, got
    os.environ["BRIEF_RC"] = "8"
    buf8 = __import__("io").StringIO()
    with __import__("contextlib").redirect_stdout(buf8):
        assert ask_main(["加輪", "--ask", "不明"]) == 0
    assert "已直送" in buf8.getvalue() and "11.md" not in buf8.getvalue(), buf8.getvalue()  # 8＝可能已送，不再印給 Router
    os.environ["BRIEF_RC"] = "7"
    assert ask_main(["加輪", "--ask", "再一次"]) == 0  # brief 失敗 → 照舊印結果，rc 跟 main 一樣
    del os.environ["BRIEF_RC"]
    assert ask_main(["加輪", "--ask", ""]) == 2
    print("selftest ok")


if __name__ == "__main__":
    if sys.argv[1:] == ["--selftest"]:
        selftest()
    elif "--ask" in sys.argv[1:]:
        sys.exit(ask_main(sys.argv[1:]))
    else:
        sys.exit(main(sys.argv[1:]))
