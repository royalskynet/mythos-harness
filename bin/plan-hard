#!/usr/bin/env bash
# plan-hard — hard 任務的規劃人：唯讀跑一次強模型，印出計畫給執行人照做。
# 用法：plan-hard '<任務原話＋需要的前文>'（在要動手的目錄裡跑）
# router-guard 判成 hard 的子代理要先跑過這支才准動其他工具。
# 環境變數：MYTHOS_PLANNER_BIN（預設 claude）、MYTHOS_PLANNER_MODEL（預設 claude-opus-5-5）、
#           MYTHOS_PLANNER_TIMEOUT_S（預設 170）、MYTHOS_PLANNER_MAX_TURNS（預設 6）、MYTHOS_PLANNER_MAX_USD（預設 1）、
#           MYTHOS_PLAN_LOG（預設 state/plan-hard.log）、MYTHOS_PLANNER_KEY_FILE（存 Anthropic API key 的檔；可寫在本機 state/plan-hard.env）
# 退出碼：0 有計畫｜2 用法｜3 找不到規劃人｜其他＝規劃人失敗（照實回報，不自己編計畫）
set -u
task="${1:-}"
[ -n "$task" ] || { echo "用法：plan-hard '<任務>'" >&2; exit 2; }
bin="${MYTHOS_PLANNER_BIN:-claude}"
command -v "$bin" >/dev/null 2>&1 || bin="$HOME/.local/bin/claude"
command -v "$bin" >/dev/null 2>&1 || { echo "plan-hard: 找不到規劃人 ${MYTHOS_PLANNER_BIN:-claude}" >&2; exit 3; }
model="${MYTHOS_PLANNER_MODEL:-claude-opus-5-5}"
root="$(cd "$(dirname "$0")/.." && pwd)"
log="${MYTHOS_PLAN_LOG:-$root/state/plan-hard.log}"
# 有 API key 就走 Anthropic API（按量計費），沒有就走 claude 訂閱登入。key 只從檔案讀進這個行程，不印出來。
# 11-12 實測這把 key 回 Credit balance is too low，所以本機 state/plan-hard.env 先停用（改名 .off）。
[ -r "$root/state/plan-hard.env" ] && . "$root/state/plan-hard.env"
if [ -z "${ANTHROPIC_API_KEY:-}" ] && [ -r "${MYTHOS_PLANNER_KEY_FILE:-}" ]; then ANTHROPIC_API_KEY="$(tr -d '\r\n' < "$MYTHOS_PLANNER_KEY_FILE")"; fi
auth=sub; [ -n "${ANTHROPIC_API_KEY:-}" ] && { export ANTHROPIC_API_KEY; auth=api; }
to=""; command -v timeout >/dev/null 2>&1 && to="timeout ${MYTHOS_PLANNER_TIMEOUT_S:-170}"
prompt="你是規劃人，只規劃不動手。讀需要的檔案後，為下面的任務寫一份執行人可以照做的計畫：
1. 目標一句。 2. 步驟（每步一個動作，寫明檔案絕對路徑與指令）。 3. 一條會失敗的驗收指令。 4. 風險與不可逆的地方。
最多讀 4 次檔就要交計畫（超過回合上限會整份作廢）。計畫直接印出來、不寫檔，60 行以內，不寫客套話。

任務：
$task"
start=$(date +%s)
# 只載專案層設定：使用者層的 hook／外掛不跟著跑；唯讀工具，動不了檔。
# 回合上限：23 次實測中位 2 回合，一次離群跑到 9 次工具；碰到上限 claude 印 Reached max turns、rc=1。
$to "$bin" -p --model "$model" --max-turns "${MYTHOS_PLANNER_MAX_TURNS:-6}" --max-budget-usd "${MYTHOS_PLANNER_MAX_USD:-1}" --setting-sources project --tools Read Grep Glob <<<"$prompt"
rc=$?
mkdir -p "$(dirname "$log")" 2>/dev/null && printf '%s\t%s\trc=%s\t%ss\t%s\n' "$(date +%s)" "$model" "$rc" "$(( $(date +%s) - start ))" "$auth" >> "$log" 2>/dev/null
exit "$rc"
