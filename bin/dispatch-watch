#!/usr/bin/env bash
# 派工回報：dcq 結果 + deep 停滯／抽查。Mythos pane 閒置才打進去。
# A（11-03）：終態先落 state/events.jsonl，送進 tmux 不算數，要主 session transcript 出現 event_id=… 才算 ACK；
#   未 ACK 10 分鐘重送（tries 上限 5，之後交 bin/watchdog）。
set -u

# 每輪總時限（11-04）：前一輪卡住時 launchd 不會起下一輪，00:07 那輪卡在舊版 awk 無窮迴圈，投遞停了 19 小時。
# perl 把本檔放進新的 process group 跑，逾時整組 TERM、2 秒後 KILL（含 awk 這類孫行程），告警寫 brief-lines，exit 124。
# 鎖：TERM 時多半由本檔 EXIT trap 清；來不及清的由 perl 依 pid 收（測試 hang-ignore-term）。
if [ -z "${DW_DEADLINE_ARMED:-}" ]; then
  export DW_DEADLINE_ARMED=1
  exec perl -e '
    my ($t, $alert, $lock) = (shift, shift, shift);
    my $pid = fork() // exit 1;
    if (!$pid) { setpgrp(0, 0); exec @ARGV; exit 127 }
    $SIG{ALRM} = sub {
      kill "TERM", -$pid; sleep 2; kill "KILL", -$pid; waitpid($pid, 0);
      # bash 等前景子行程時不一定來得及跑 EXIT trap（CI 41848055485 實測鎖殘留）：鎖還是被殺那輪的 pid 就清掉
      if (open my $p, "<", "$lock/pid") { chomp(my $o = <$p> // ""); close $p; system("rm", "-rf", $lock) if $o eq "$pid" }
      my @l = localtime; my $ts = sprintf "%04d-%02d-%02d %02d:%02d:%02d", $l[5]+1900, $l[4]+1, @l[3,2,1,0];
      (my $d = $alert) =~ s{/[^/]*$}{}; mkdir $d;
      if (open my $f, ">>", $alert) { print $f "$ts dispatch-watch 一輪超過 ${t}s 被終止\n" } else { print STDERR "alert 寫入失敗: $!\n" }
      exit 124;
    };
    alarm $t; waitpid($pid, 0);
    exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
  ' "${DW_MAX_SEC:-300}" "${BRIEF_LINES_DIR:-$HOME/.cache/brief-lines}/mythos-watch.txt" \
    "${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}/state/.dispatch-watch.lock" /bin/bash "$0" "$@"
fi

MYTHOS_DIR="${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
DCQ_HOME="${DCQ_HOME:-$HOME/.dcq}"
TMUX_BIN="${TMUX_BIN:-tmux}"
TIMEOUT_MIN="${DISPATCH_TIMEOUT_MIN:-90}"
# 旋鈕（11-04）：bin/watchdog L2 寫 state/watchdog-knobs.env（KEY=整數）。只認這四條、不 source／不 eval；
# 環境變數優先，沒設才用檔內值。ponytail: 目前只有四個旋鈕，新增要同步改這裡的 case 與測試白名單。
KNOBS_FILE="$MYTHOS_DIR/state/watchdog-knobs.env"
if [ -f "$KNOBS_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      DEEP_STALL_MIN=*|DEEP_REVIEW_MIN=*|DEEP_HANDOFF_SEC=*|BG_STALL_MIN=*) ;;
      *) continue ;;
    esac
    k="${line%%=*}" v="${line#*=}"
    case "$v" in ''|*[!0-9]*) continue ;; esac
    eval "[ -n \"\${$k+x}\" ]" && continue
    eval "$k=\$v"
  done < "$KNOBS_FILE"
fi
DEEP_STALL_MIN="${DEEP_STALL_MIN:-15}"
DEEP_REVIEW_MIN="${DEEP_REVIEW_MIN:-30}"
# F3：pending 逾時還沒寫 handle／rc 就當啟動失敗，落 failed 終態釋放 repo
DEEP_HANDOFF_SEC="${DEEP_HANDOFF_SEC:-120}"
# bg／bg-hard 停在 working 超過它的分鐘數 → STALL 事件（worker 卡在權限提示或卡死）
BG_STALL_MIN="${BG_STALL_MIN:-60}"
# 真進度（11-04，借鏡 DeepSeek Super-agent 的 watchdog）：看 worker transcript 有沒有在動，不只看開派多久。
# 開派超過 BG_NOSTART_MIN 分鐘還沒有 transcript＝沒開工（短 id 續派卡死就是這樣，等了 60 分鐘才發現）；
# 有 transcript 就以最後寫入時間算停滯，長時間但還在動的 worker 不判 STALL。
BG_NOSTART_MIN="${BG_NOSTART_MIN:-5}"
BG_PROJECTS_DIR="${BG_PROJECTS_DIR:-$HOME/.claude/projects}"
# 11-05：worker 狀態先變 done、result 晚幾十秒才寫好（t-dsh 的 bg-6cd59e09 差 20 秒就被判「result 缺檔」）。
# 缺檔時先寬限這麼多秒（記第一次看到的時間在 state/bg/<id>.done-seen），期間不發 PASS。
BG_RESULT_GRACE_SEC="${BG_RESULT_GRACE_SEC:-120}"
# E2：bg 單 PASS 直發使用者（至多一次）。tg-send 跟本檔同目錄；告警只寫 brief-lines。
TG_SEND_BIN="${TG_SEND_BIN:-$(cd "$(dirname "$0")" && pwd)/tg-send}"
BRIEF_BIN="${BRIEF_BIN:-$(cd "$(dirname "$0")" && pwd)/brief-answer}"
# 11-07 自癒：bg 單 FAIL／STALL 先機械重派一次（STALL 先 cancel），重派的再失敗才用秘書口吻直接告訴使用者；都不交 Router。BG_AUTOHEAL=0 關閉
BG_AUTOHEAL="${BG_AUTOHEAL:-1}"
DISPATCH_BG_BIN="${DISPATCH_BG_BIN:-$(cd "$(dirname "$0")" && pwd)/dispatch-bg}"
DISPATCH_CANCEL_BIN="${DISPATCH_CANCEL_BIN:-$(cd "$(dirname "$0")" && pwd)/dispatch-cancel}"
BRIEF_LINES_DIR="${BRIEF_LINES_DIR:-$HOME/.cache/brief-lines}"
DIRECT_SENDING_SEC="${DIRECT_SENDING_SEC:-600}"
# 11-06 未收尾檢查：FAIL／STALL／TIMEOUT 單超過 UNRESOLVED_HOURS 小時沒有收尾記錄就升級（至多 UNRESOLVED_MAX 次，之後寫 brief-lines 一次）。
# 帳本 pending 但單已死（dcq 單不在任何佇列、bg worker 不在 claude agents、deep runner pid 已不在）超過 GONE_MIN 分鐘 → 自動對帳成終態。
# 復原：cp bin/dispatch-watch.bak-20261106-closeout bin/dispatch-watch
UNRESOLVED_HOURS="${UNRESOLVED_HOURS:-6}"
UNRESOLVED_MAX="${UNRESOLVED_MAX:-3}"
GONE_MIN="${GONE_MIN:-30}"
CLOSEOUTS="$MYTHOS_DIR/state/closeouts.tsv"
if [ "${DISPATCH_WATCH_PRINT_KNOBS:-}" = 1 ]; then
  printf 'DEEP_STALL_MIN=%s DEEP_REVIEW_MIN=%s DEEP_HANDOFF_SEC=%s BG_STALL_MIN=%s\n' "$DEEP_STALL_MIN" "$DEEP_REVIEW_MIN" "$DEEP_HANDOFF_SEC" "$BG_STALL_MIN"
  exit 0
fi
# 抽查兩段過濾（11-02）：fast path 是這支腳本的 mtime／間隔判斷，slow path 交免費模型，
# 只有 OFF_TRACK／STUCK／看不懂才喚醒 Mythos。沒這支或不可執行＝退回舊行為（每次抽查都喚醒）。
REVIEW_JUDGE="${REVIEW_JUDGE:-$MYTHOS_DIR/bin/review-judge}"
# deepclaude 用自己的 CLAUDE_CONFIG_DIR，transcript 不在 ~/.claude/projects（11-02 實查）
CLAUDE_PROJECTS_DIR="${CLAUDE_PROJECTS_DIR:-$HOME/.deepclaude/config/projects}"
# 主 session transcript：取 mtime 最新的 *.jsonl
# transcript 目錄＝工作目錄路徑把非英數字換成 -（跟 dispatch-gate 同一條算式，去個人化）
ROUTER_SLUG="$(printf '%s' "$MYTHOS_DIR" | sed 's/[^A-Za-z0-9]/-/g')"
ROUTER_DIR="${MYTHOS_TRANSCRIPT_DIR:-$HOME/.claude/projects/${ROUTER_SLUG}}"
export ROUTER_DIR
EVENTS_FILE="$MYTHOS_DIR/state/events.jsonl"
TSV="$MYTHOS_DIR/state/dispatch-jobs.tsv"
RESEND_SEC=600
MAX_TRIES=5
# 抽查（judge）總預算秒數，從抽查階段開始算；終態投遞在抽查之前做完，不受它影響
JUDGE_BUDGET="${JUDGE_BUDGET:-90}"
NODE_BIN="${NODE_BIN:-node}"
LIB="$(cd "$(dirname "$0")" && pwd)/lib-events.mjs"
WATCH_LOG="$MYTHOS_DIR/logs/dispatch-watch.log"
CTX_GUARD="${CTX_GUARD_BIN:-$(cd "$(dirname "$0")" && pwd)/ctx-guard}"
if [ -n "${CTX_GUARD_OFF:-}" ] || [ ! -x "$CTX_GUARD" ]; then CTX_GUARD=/usr/bin/true; fi

# 測試守門（F1／F3）：放在第一次讀寫 $TSV 或 events 之前，任何改動都不會落地
RUNNER="${DISPATCH_DEEP_RUN_BIN:-$(cd "$(dirname "$0")" && pwd)/dispatch-deep-run}"
if [ -n "${MYTHOS_TEST_SANDBOX:-}" ]; then
  for b in "$RUNNER" "$TMUX_BIN" "${CLAUDE_BIN:-claude}"; do
    case "$b" in
      "$MYTHOS_TEST_SANDBOX"/*) ;;
      *) echo "測試模式拒跑真 runner" >&2; exit 97 ;;
    esac
  done
fi

# lib 跟腳本走（不跟 MYTHOS_DIR）：測試／別處呼叫時 MYTHOS_DIR 是暫存目錄，沒有 bin/
. "$(cd "$(dirname "$0")" && pwd)/lib-ledger.sh"

[ -f "$TSV" ] || exit 0
mkdir -p "$MYTHOS_DIR/state" 2>/dev/null || exit 0
mkdir -p "$MYTHOS_DIR/state/deep" 2>/dev/null || true

LOCK="$MYTHOS_DIR/state/.dispatch-watch.lock"
mkdir "$LOCK" 2>/dev/null || exit 0
# 鎖內記 pid：watchdog 靠它判斷持有者是否已死（C）
printf '%s\n' "$$" > "$LOCK/pid"

OUT="$(mktemp "${TMPDIR:-/tmp}/dispatch-watch-tsv.XXXXXX")" || { rm -rf "$LOCK"; exit 0; }
TODOS="$(mktemp "${TMPDIR:-/tmp}/dispatch-watch-todos.XXXXXX")" || { rm -f "$OUT"; rm -rf "$LOCK"; exit 0; }
REVIEWS="$(mktemp "${TMPDIR:-/tmp}/dispatch-watch-reviews.XXXXXX")" || { rm -f "$OUT" "$TODOS"; rm -rf "$LOCK"; exit 0; }
cleanup() { rm -f "$OUT" "$TODOS" "$REVIEWS"; rm -rf "$LOCK"; }
trap cleanup EXIT

now="$(date +%s)"
late=0
log() { mkdir -p "$(dirname "$WATCH_LOG")" 2>/dev/null; printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$WATCH_LOG"; }

mtime_of() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0
}

slug_of() { printf '%s' "$1" | sed 's/[\/.]/-/g'; }

# 同一 event_id 只建一次，回 new／existing
add_event() { # id status task extra guide
  local id="$1" eid="$1-$2" st="$2" task="$3" extra="$4" guide="$5" payload base
  # 終態冪等（<job>-<狀態>）；STALL／REVIEW 是週期性的，帶時間才不會一張票只抽查一次
  case "$st" in STALL|REVIEW|UNRESOLVED) eid="$1-$2-$now" ;; esac
  # 同一票同一類型已有未 ACK 的事件就不再建（pane 一直忙時不會每輪多一筆）
  if jq -e --arg id "$id" --arg st "$st" 'select(.job_id==$id and .status==$st and .acked_at == null)' "$EVENTS_FILE" >/dev/null 2>&1; then
    return 1
  fi
  base="${task##*/}"
  # 11-06 ctx-guard：該 job 的 session 接近／超過 context 上限就標在 extra（備份 bin/dispatch-watch.bak-20261106-ctxguard）
  local cn
  cn="$("$CTX_GUARD" note "$id" 2>/dev/null </dev/null 9>&-)" || cn=''
  [ -n "$cn" ] && extra="${extra:+$extra；}⚠ $cn"
  local th
  th="$(awk -F'\t' -v j="$1" '$1 == j { NF=8; print $7; exit }' "$TSV")"
  case "$th" in ''|-|*[!A-Za-z0-9-]*) th=- ;; esac
  payload="$(jq -cn --arg eid "$eid" --arg id "$id" --arg st "$st" --arg sum "$base" --arg tk "$task" --arg th "$th" \
    --arg extra "$extra" --arg guide "$guide" --argjson now "$now" \
    '{event_id:$eid, job_id:$id, task:$tk, status:$st, summary:$sum, thread:$th, extra:$extra, guide:$guide,
      created:$now, delivered_at:null, acked_at:null, tries:0}')"
  # events 寫入持 ledger 鎖（P1，11-04：多寫者互蓋）
  [ "$(ledger_events upsert "$EVENTS_FILE" "$payload")" = new ]
}

todo() { printf '%s\t%s\n' "$1" "$2" >> "$TODOS"; }

# E2 直發：結果不明＝當已處理（acked），寫一行告警，這張票的投遞到此結束（寧漏不重）
direct_unknown() { # job eid
  ledger_events set "$EVENTS_FILE" "$2" "{\"direct\":\"unknown\",\"acked_at\":$now}" >/dev/null || return 0
  mkdir -p "$BRIEF_LINES_DIR" 2>/dev/null &&
    printf '%s 直發結果不明 %s\n' "$(TZ=Asia/Taipei date '+%F %H:%M')" "$1" >> "$BRIEF_LINES_DIR/mythos-direct.txt"
  log "direct unknown $2"
}
# 只在 add_event 本輪新建 PASS 後呼叫：先標 sending（deliver 會跳過），再送；0 已送、1/97 確定沒送交 Router、其他不明
# 直發只送 result 裡寫給使用者的那段：「摘要：」到「---細節---」之間（11-04：整份 result 是寫給 Router 的術語）。
# 兩個標記缺一或中間是空的 → 印空，呼叫端不直發，事件照舊交 Router 轉述。
summary_of() { # result檔
  awk '/^---細節---[[:space:]]*$/ { if (on) { ok = 1; exit } }
       on { buf = buf $0 "\n"; next }
       /^摘要[:：]/ { on = 1; sub(/^摘要[:：][[:space:]]*/, ""); if ($0 != "") buf = $0 "\n" }
       END { if (ok) printf "%s", buf }' "$1" 2>/dev/null | sed '/./,$!d'
}

# 交辦原話：chat-prompt 寫的 prompt 用「> 」引用原話；舊式 prompt 取前 600 字
task_ask() { # task檔
  if [ -f "$1" ]; then
    grep '^> ' "$1" 2>/dev/null | sed 's/^> //' | grep . || head -c 600 "$1"
  else printf '%s\n' "$1"; fi
}
# 11-07：推給使用者的內容一律交 brief-answer 改寫成秘書口吻（不帶 thread 代號、路徑、commit），改寫失敗推原文
brief_text() { # kind task < 資料
  local out
  mkdir -p "$(dirname "$WATCH_LOG")" 2>/dev/null
  out="$(BRIEF_TIMEOUT="${BRIEF_TIMEOUT:-45}" "$BRIEF_BIN" --stdout --kind "$1" --q "$(task_ask "$2" | head -c 1200)" 9>&- 2>>"$WATCH_LOG")" || out=''
  printf '%s\n' "$out"
}
direct_send() { # job eid thread 摘要檔 task
  local rc text
  mkdir -p "$(dirname "$WATCH_LOG")" 2>/dev/null
  ledger_events set "$EVENTS_FILE" "$2" '{"direct":"sending"}' >/dev/null || return 0
  text="$(brief_text done "${5:-$1}" < "$4")"
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || text="$(cat "$4")"
  printf '%s\n' "$text" \
    | MYTHOS_DIR="$MYTHOS_DIR" "${NODE_BIN:-node}" "$TG_SEND_BIN" --thread "$3" --job "$1" 9>&- >/dev/null 2>>"$WATCH_LOG"
  rc=${PIPESTATUS[1]}
  case "$rc" in
    0) ledger_events set "$EVENTS_FILE" "$2" "{\"direct\":\"sent\",\"acked_at\":$now}" >/dev/null; log "direct sent $2" ;;
    1|97) ledger_events set "$EVENTS_FILE" "$2" '{"direct":"failed"}' >/dev/null; log "direct failed rc=$rc $2" ;;
    *) direct_unknown "$1" "$2" ;;
  esac
}

# 自癒（11-07）：0＝已處理（重派成功或已直接告訴使用者，事件已 ACK）；1＝沒處理，事件照舊交 Router
bg_autoheal() { # id eid thread task extra kind(FAIL|STALL)
  local id="$1" eid="$2" th="$3" task="$4" extra="$5" kind="$6" p rc text
  [ "$BG_AUTOHEAL" = 1 ] || return 1
  mkdir -p "$(dirname "$WATCH_LOG")" 2>/dev/null
  case "$th" in ''|-|*[!A-Za-z0-9-]*) return 1 ;; esac
  if [ "$kind" = STALL ]; then
    MYTHOS_DIR="$MYTHOS_DIR" bash "$DISPATCH_CANCEL_BIN" "$id" 9>&- >/dev/null 2>>"$WATCH_LOG" || return 1
  fi
  case "${task##*/}" in
    *-autoretry-*)
      text="$(printf '這件事做到一半%s，自動重試一次也沒成功。狀況：%s\n' "$([ "$kind" = STALL ] && echo 卡住了 || echo 停了)" "$extra" | brief_text fail "$task")"
      [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || text="這件事自動重試一次還是沒做完：${extra}。要再試或換做法，回這則跟我說。"
      printf '%s\n' "$text" | MYTHOS_DIR="$MYTHOS_DIR" "${NODE_BIN:-node}" "$TG_SEND_BIN" --thread "$th" --job "$id" 9>&- >/dev/null 2>>"$WATCH_LOG"
      rc=${PIPESTATUS[1]}
      [ "$rc" = 0 ] || { log "autoheal 告知失敗 rc=$rc $eid"; return 1; }
      ledger_events set "$EVENTS_FILE" "$eid" "{\"direct\":\"sent\",\"acked_at\":$now}" >/dev/null
      log "autoheal 第二次失敗已告知使用者 $eid"
      return 0 ;;
  esac
  p="$MYTHOS_DIR/state/bg/$th-autoretry-$now.md"
  { printf '上一位 worker 中途%s（%s）。接續原任務做完：先檢查已完成的部分再沿用，不要整個重做。\n\n' \
      "$([ "$kind" = STALL ] && echo 卡住被停掉 || echo 停止)" "$extra"
    if [ -f "$task" ]; then cat "$task"; else printf '%s\n' "$task"; fi; } > "$p" 2>/dev/null || return 1
  MYTHOS_DIR="$MYTHOS_DIR" bash "$DISPATCH_BG_BIN" "$th" "$p" 9>&- >/dev/null 2>>"$WATCH_LOG" || { log "autoheal 重派失敗 $eid"; return 1; }
  ledger_events set "$EVENTS_FILE" "$eid" "{\"direct\":\"retried\",\"acked_at\":$now}" >/dev/null
  log "autoheal 已重派 $eid → ${p##*/}"
  return 0
}

# 0) 同 repo 佇列（C3）：持鎖把 queued 依 epoch 由舊到新拉起。同一個 top 已有 pending、未寫 rc 的 deep 票就跳過，
#    每個 top 這輪最多啟一張；啟動跟 bin/dispatch 同一條（DISPATCH_DEEP_RUN_BIN 可換）。
#    queued 卻已有 rc（異常落地）→ 只改回 pending 不啟動，交給下面第 1 步照一般 deep 票出 PASS／FAIL。
#    ponytail: 每張 queued 都重掃全表算 top，O(n²)；票上百張再改成先算好各列 top。
top_of() { git -C "$1" rev-parse --show-toplevel 2>/dev/null 9>&- || printf %s "$1"; }

# 0a) F3 啟動交接失敗：deep 票 pending、沒 rc、沒 handle、距 epoch 超過 DEEP_HANDOFF_SEC
#     → 只寫 <id>.handoff（原因）＋rc=127，不改 ledger、不發事件（F2）。repo 由第 1 步照一般 deep 票出 FAIL 釋放。
#     寫失敗（拿不到鎖、原因寫不了、rc 已存在）只留到下輪重掃，可重試。放在拉 queued 之前。
#     F1：全程持 ledger 鎖並在鎖內重查 pending／handle／rc——runner 的第一版 handle 也在鎖內寫，
#     不持鎖的話「掃到沒 handle」與「runner 寫 handle」之間會誤判啟動失敗。
fail_handoff() { # id
  local id="$1" rcf="$MYTHOS_DIR/state/deep/$1.rc" hf="$MYTHOS_DIR/state/deep/$1.handoff" msg
  ledger_lock || return 0
  if [ "$(awk -F'\t' -v i="$id" '$1 == i { NF=8; print $5; exit }' "$TSV")" != pending ] \
    || [ -e "$rcf" ] || [ -e "$MYTHOS_DIR/state/deep/$id.handle" ]; then
    ledger_unlock; return 0
  fi
  msg="runner 未啟動（${DEEP_HANDOFF_SEC}s 內沒寫 handle）"
  # 原因先寫：rc 一落地第 1 步就出 FAIL 事件，原因晚寫會被吃掉
  if ! { printf '%s\n' "$msg" > "$hf"; } 2>/dev/null; then ledger_unlock; return 0; fi
  if ! ( set -o noclobber; printf '127\n' > "$rcf" ) 2>/dev/null; then ledger_unlock; return 0; fi
  ledger_unlock
  log "handoff 逾時 ${DEEP_HANDOFF_SEC}s：$id 寫 handoff＋rc=127"
}
# end fail_handoff
while IFS=$'\t' read -r id _ task epoch status _ _ backend; do
  [ "$status" = pending ] && [ "$backend" = deep ] || continue
  [ -f "$MYTHOS_DIR/state/deep/$id.rc" ] && continue
  [ -f "$MYTHOS_DIR/state/deep/$id.handle" ] && continue
  case "$epoch" in ''|*[!0-9]*) continue ;; esac
  [ $((now - epoch)) -gt "$DEEP_HANDOFF_SEC" ] && fail_handoff "$id"
done < <(ledger_fields < "$TSV")

# 1) bg／bg-hard：state 以 `claude agents --json --all` 為準（sessionId 前 8 碼＝短 id）。
#    done → 讀 state/bg/<短id>.result 走既有事件投遞；缺檔退讀 `claude logs` 並標「result 缺檔」。
#    working 超過 BG_STALL_MIN 分鐘 → STALL。每輪只叫一次 claude agents（20 秒硬上限）。
bg_pending=0
# 順序有講究：3.2 的 $'' 從不外銷，命令行上寫 TAB 照樣存成 Tab，傳給子行程（claude stub 的 cat 也讀它）
while IFS="$(printf '	')" read -r _bgid _bgtier _bgtask _bgepoch _bgstatus _bgcwd _bgth _bgbackend; do
  if [ "$_bgstatus" = pending ]; then
    case "$_bgbackend" in bg|bg-hard) bg_pending=1; break ;; esac
  fi
done < <(ledger_fields < "$TSV")
AGENTS_JSON=''
if [ "$bg_pending" = 1 ]; then
  export AGENTS_JSON
  # 只挑一個 timer：`timeout … || 無 timeout 版` 會讓 claude agents 每輪跑兩次
  # 兩個子行程都 </dev/null：`while read` 的行不能被子行程（stub 的 cat）吃進 stdin
  if command -v timeout >/dev/null 2>&1; then TO=(timeout -k 5 20)
  elif command -v gtimeout >/dev/null 2>&1; then TO=(gtimeout -k 5 20)
  else TO=()
  fi
  AGENTS_JSON="$("${TO[@]}" "${CLAUDE_BIN:-claude}" agents --json --all </dev/null 9>&- 2>/dev/null)" || AGENTS_JSON=''

  printf '%s' "$AGENTS_JSON" | "$NODE_BIN" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{if(Array.isArray(JSON.parse(s)))process.exit(0)}catch{}process.exit(1)})' 9>&- 2>/dev/null || AGENTS_JSON=''
fi
# 短 id → state（沒有就空）
bg_state() {
  [ -n "$AGENTS_JSON" ] || return 0
  printf '%s' "$AGENTS_JSON" | "$NODE_BIN" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const id=process.argv[1];let a=[];try{a=JSON.parse(s)}catch{return}const hit=a.find(x=>(x.sessionId||"").startsWith(id))||a.find(x=>x.id===id);if(hit)process.stdout.write(String(hit.state||"")||"")})' "${1#bg-}" 9>&- 2>/dev/null
}
# 短 id → 「完整 sessionId<TAB>cwd」（兩個都有才印）
bg_info() {
  [ -n "$AGENTS_JSON" ] || return 0
  printf '%s' "$AGENTS_JSON" | jq -r --arg s "${1#bg-}" \
    '[.[]? | select((.sessionId // "") | startswith($s + "-")) | select(.cwd) | "\(.sessionId)\t\(.cwd)"][0] // empty' 2>/dev/null
}
# result 缺檔時的替代內容：claude logs 是 TUI 畫面（滿是 ESC 控制碼），先去掉控制碼；去完是空的，
# 就退讀 worker transcript 最後一段 assistant 文字；都沒有才寫「讀不到」。
bg_missing_extra() { # id sid → 印一行（已含「result 缺檔；」前綴）
  local raw txt info tf
  raw="$(${TO[@]+"${TO[@]}"} "${CLAUDE_BIN:-claude}" logs "$2" </dev/null 9>&- 2>/dev/null)" || raw=''
  txt="$(printf '%s' "$raw" | perl -pe 's/\e\[[0-9;?]*[ -\/]*[@-~]//g; s/\e[()][A-Za-z0-9]//g; s/[\x00-\x08\x0b-\x1f\x7f]//g' 2>/dev/null | tr -s ' ')"
  [ -n "$(printf '%s' "$txt" | tr -d '[:space:]')" ] || txt=''
  if [ -z "$txt" ]; then
    info="$(bg_info "$1")"
    if [ -n "$info" ]; then
      tf="$BG_PROJECTS_DIR/$(printf '%s' "${info#*	}" | sed 's/[\/.]/-/g')/${info%%	*}.jsonl"
      [ -f "$tf" ] && txt="$(jq -rs '[.[] | select(.type=="assistant") | .message.content[]? | select(.type=="text") | .text][-1] // empty' "$tf" 2>/dev/null)"
    fi
  fi
  printf '%s' "result 缺檔；${txt:-讀不到 claude logs}" | tr '\t\n' '  ' | cut -c1-300
}
# 1-ctx) 零 token context 守衛：掃 Router／worker／deep transcript 的實際 usage，超限動作與告警見 bin/ctx-guard。
#    掛掉不影響派工回報；CTX_GUARD_OFF=1 關閉。
${TO[@]+"${TO[@]}"} "$CTX_GUARD" scan </dev/null 9>&- >/dev/null 2>&1 || log "ctx-guard scan 失敗 rc=$?"
# 1a0) E2：上輪直發到一半就中斷（sending 卡超過 DIRECT_SENDING_SEC）→ 照結果不明收掉，不重送
if [ -f "$EVENTS_FILE" ]; then
  while IFS="$(printf '\t')" read -r sj se; do
    [ -n "$se" ] && direct_unknown "$sj" "$se"
  done < <(jq -r --argjson now "$now" --argjson lim "$DIRECT_SENDING_SEC" \
    'select(.direct == "sending" and .acked_at == null and ($now - .created) >= $lim) | [.job_id, .event_id] | @tsv' "$EVENTS_FILE" 2>/dev/null)
fi
# 1a) bg／bg-hard 掃描：done 走事件投遞、working 逾時發 STALL
while IFS="$(printf '\t')" read -r id tier task epoch status cwd thread backend; do
  [ "$status" = pending ] || continue
  case "$backend" in bg|bg-hard) ;; *) continue ;; esac
  sid="${id#bg-}"
  st="$(bg_state "$id")"
  case "$st" in
    done|completed|exited)
      rf="$MYTHOS_DIR/state/bg/$sid.result"
      extra=''
      if [ -s "$rf" ]; then
        extra="$(tr '\t\n' '  ' < "$rf" | cut -c1-300)"
      else
        seen="$MYTHOS_DIR/state/bg/$sid.done-seen"
        [ -f "$seen" ] || printf '%s\n' "$now" > "$seen"
        s0="$(tr -d '[:space:]' < "$seen" 2>/dev/null)"; case "$s0" in ''|*[!0-9]*) s0="$now" ;; esac
        [ $((now - s0)) -ge "$BG_RESULT_GRACE_SEC" ] || continue
        extra="$(bg_missing_extra "$id" "$sid")"
      fi
      guide="看結果決定：要續派用 bin/dispatch-bg --thread $thread <prompt檔>，卡死就 bin/dispatch-cancel $id"
      if add_event "$id" PASS "$task" "$extra" "$guide" >/dev/null && [ "$backend" = bg ] && [ -s "$rf" ]; then
        sf="$MYTHOS_DIR/state/bg/$sid.summary"
        if summary_of "$rf" > "$sf" && [ -n "$(tr -d '[:space:]' < "$sf")" ]; then
          if [ "$(head -1 "$sf" | tr -d '[:space:]')" = "[靜默]" ]; then
            # 11-06：例行排程（daily-backlog）沒事時不推 TG；摘要第一行寫 [靜默] 就只 ack、不直發不交 Router
            ledger_events set "$EVENTS_FILE" "$id-PASS" "{\"direct\":\"quiet\",\"acked_at\":$now}" >/dev/null && log "quiet ack $id-PASS"
          else
            direct_send "$id" "$id-PASS" "$thread" "$sf" "$task"
          fi
        else
          log "no summary, Router 轉述 $id-PASS"
        fi
      fi
      ;;
    working|busy|running|active|blocked)
      case "$epoch" in ''|*[!0-9]*) continue ;; esac
      extra=''
      info="$(bg_info "$id")"
      if [ -n "$info" ]; then
        tf="$BG_PROJECTS_DIR/$(printf '%s' "${info#*	}" | sed 's/[\/.]/-/g')/${info%%	*}.jsonl"
        if [ -f "$tf" ]; then
          idle=$(( now - $(stat -f %m "$tf" 2>/dev/null || echo "$epoch") ))
          [ "$idle" -ge $((BG_STALL_MIN * 60)) ] || continue
          extra="對話紀錄 $((idle / 60)) 分鐘沒動"
        else
          [ $((now - epoch)) -ge $((BG_NOSTART_MIN * 60)) ] || continue
          extra="沒開工：派出 $(( (now - epoch) / 60 )) 分鐘仍沒有對話紀錄"
        fi
      else
        # claude agents 沒給 sessionId／cwd：退回只看開派多久
        [ $((now - epoch)) -ge $((BG_STALL_MIN * 60)) ] || continue
      fi
      last="$MYTHOS_DIR/state/bg/$sid.last-stall"
      if [ -f "$last" ] && [ $((now - $(tr -d '[:space:]' < "$last" 2>/dev/null || echo 0))) -lt $((BG_STALL_MIN * 60)) ]; then
        continue
      fi
      guide="判斷是否卡死；卡死就 bin/dispatch-cancel $id 再用 bin/dispatch-bg --thread $thread <prompt檔> 重派"
      if add_event "$id" STALL "$task" "$extra" "$guide" >/dev/null; then
        [ "$backend" = bg ] && bg_autoheal "$id" "$id-STALL-$now" "$thread" "$task" "$extra" STALL || true
      else late=1; fi
      todo "$last" "$now"
      ;;
    '')
      # 11-06 對帳：claude agents 有清單（AGENTS_JSON 非空）卻找不到這個 worker，超過 GONE_MIN 分鐘 → 當 FAIL，不再永遠 pending
      [ -n "$AGENTS_JSON" ] || continue
      case "$epoch" in ''|*[!0-9]*) continue ;; esac
      [ $((now - epoch)) -ge $((GONE_MIN * 60)) ] || continue
      guide="worker 已不在 claude agents 清單；要重來照原派工方式重派，或 bin/dispatch-close $id superseded \"<理由>\" 收掉"
      add_event "$id" FAIL "$task" "worker 已不在 claude agents 清單（對帳）" "$guide" >/dev/null &&
        { [ "$backend" = bg ] && bg_autoheal "$id" "$id-FAIL" "$thread" "$task" "worker 不見了" FAIL || true; }
      ;;
    stopped|failed|error|killed)
      # F4：worker 沒寫 result 就停了 → 終態 FAIL，不再永遠 pending
      rf="$MYTHOS_DIR/state/bg/$sid.result"
      if [ -s "$rf" ]; then
        extra="$(tr '\t\n' '  ' < "$rf" | cut -c1-300)"
      else
        extra="$(bg_missing_extra "$id" "$sid")"
      fi
      guide="worker 已停止（${st}）；要重來照原派工方式重派（bg-hard 記得 --hard 與原 repo），或 bin/dispatch-cancel $id 收掉"
      add_event "$id" FAIL "$task" "$extra" "$guide" >/dev/null &&
        { [ "$backend" = bg ] && bg_autoheal "$id" "$id-FAIL" "$thread" "$task" "$extra" FAIL || true; }
      ;;
  esac
done < <(ledger_fields < "$TSV")

# F8：升級只改被拉起的列（補成 8 欄、OFS 用 tab），其餘原樣寫回；抽成函式給 tests/test-repo-queue.sh 做突變。
# F5：同時把第 4 欄 epoch 改成當下，排隊時間不算進執行時間（watchdog 6 小時、REVIEW 30 分鐘、handoff 都看它）。
promote_rows() { # promote 清單檔 ledger 檔 now → 新 ledger 印到 stdout
  awk -F'\t' -v now="$3" 'BEGIN { OFS="\t" } NR==FNR { up[$1]=1; next } ($1 in up) { NF=8; $5="pending"; $4=now } { print }' "$1" "$2"
}
# end promote_rows
if awk -F'\t' '$5=="queued"' "$TSV" 2>/dev/null | grep -q .; then
  ledger_lock || exit 0
  QDIR="$(mktemp -d "${TMPDIR:-/tmp}/dispatch-watch-queue.XXXXXX")" || { ledger_unlock; exit 0; }
  : > "$QDIR/promote"; : > "$QDIR/launch"; : > "$QDIR/tops"
  while IFS=$'\t' read -r qid _ qtask _ qst qcwd _ qbackend; do
    [ "$qst" = queued ] && [ "$qbackend" = deep ] || continue
    if [ -f "$MYTHOS_DIR/state/deep/$qid.rc" ]; then
      printf '%s\n' "$qid" >> "$QDIR/promote"
      continue
    fi
    top="$(top_of "$qcwd")"
    grep -qxF -- "$top" "$QDIR/tops" && continue
    busy=0
    while IFS=$'\t' read -r oid _ _ _ ost ocwd _ obackend; do
      [ "$ost" = pending ] && [ "$obackend" = deep ] || continue
      [ -f "$MYTHOS_DIR/state/deep/$oid.rc" ] && continue
      [ "$(top_of "$ocwd")" = "$top" ] && { busy=1; break; }
    done < <(ledger_fields < "$TSV")
    [ "$busy" = 1 ] && continue
    printf '%s\n' "$qid" >> "$QDIR/promote"
    printf '%s\t%s\t%s\n' "$qid" "$qtask" "$qcwd" >> "$QDIR/launch"
    printf '%s\n' "$top" >> "$QDIR/tops"
  done < <(ledger_fields < "$TSV" | sort -t$'\t' -k4,4n)
  if [ -s "$QDIR/promote" ] \
    && promote_rows "$QDIR/promote" "$TSV" "$now" > "$QDIR/tsv" \
    && mv "$QDIR/tsv" "$TSV"; then
    ledger_unlock
    while IFS=$'\t' read -r qid qtask qcwd; do
      [ -n "$qid" ] || continue
      nohup "$RUNNER" "$qid" "$qtask" "$qcwd" >/dev/null 2>&1 9>&- &
    done < "$QDIR/launch"
  else
    ledger_unlock
  fi
  rm -rf "$QDIR"
fi

# 0c) 認養直投 dcq 的失敗單（11-06）：沒經 bin/dispatch 的單（直接 dcq add）失敗後帳本沒有列，
#     派工回報與未收尾檢查都看不到。failed 匣有 .job 而帳本沒有那個 id → 補一列 pending，之後走同一套 FAIL／未收尾流程。
#     使用者取消的（CANCELLED=1）不認養。時間用 failed 檔 mtime，所以 6 小時是從失敗時算。
# 復原：cp bin/dispatch-watch.bak-20261106-closeout2 bin/dispatch-watch
adopt_orphan_failures() {
  local f id t c e miss=''
  [ -d "$DCQ_HOME/failed" ] || return 0
  for f in "$DCQ_HOME"/failed/*.job; do
    [ -f "$f" ] || continue
    id="$(basename "$f" .job)"
    grep -q '^CANCELLED=1' "$f" 2>/dev/null && continue
    cut -f1 "$TSV" 2>/dev/null | grep -qxF -- "$id" && continue
    miss="$miss $f"
  done
  [ -n "$miss" ] || return 0
  ledger_lock || return 0
  for f in $miss; do
    id="$(basename "$f" .job)"
    cut -f1 "$TSV" 2>/dev/null | grep -qxF -- "$id" && continue
    t="$(sed -n 's/^TASK0=//p' "$f" | head -1)"; [ -n "$t" ] || t="$(sed -n 's/^TASK=//p' "$f" | head -1)"
    c="$(sed -n 's/^CWD0=//p' "$f" | head -1)"; [ -n "$c" ] || c="$(sed -n 's/^CWD=//p' "$f" | head -1)"
    e="$(stat -f %m "$f" 2>/dev/null || date +%s)"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" mid "${t:--}" "$e" pending "${c:-/tmp}" - dcq >> "$TSV"
    log "adopt orphan failed dcq job $id"
  done
  ledger_unlock
}
adopt_orphan_failures

# 1) 掃描 ledger：終態只寫事件、不動 ledger
while IFS=$'\t' read -r id tier task epoch status cwd thread backend; do
  [ -n "$id" ] || continue
  [ "$status" = pending ] || continue

  if [ "$backend" = deep ]; then
    rcfile="$MYTHOS_DIR/state/deep/$id.rc"
    outfile="$MYTHOS_DIR/state/deep/$id.out"
    if [ -f "$rcfile" ]; then
      rc="$(tr -d '[:space:]' < "$rcfile")"
      if [ "$rc" = "0" ]; then
        st=PASS
      else
        st=FAIL
      fi
      extra=""
      if [ "$st" = FAIL ]; then
        extra="$(tail -n 3 "$outfile" 2>/dev/null | tr '\t\n' '  ' | cut -c1-300)"
        # F2：handoff 寫的 rc 沒有 out 可看，原因放進 extra
        hf="$MYTHOS_DIR/state/deep/$id.handoff"
        if [ -f "$hf" ]; then
          extra="$(head -1 "$hf" | tr '\t\n' '  ')${extra:+；$extra}"
        fi
      fi
      case "$st" in
        PASS) guide="請重跑工單驗收並看改動範圍後收尾" ;;
        FAIL) guide="看 state/deep/$id.out，判斷後用 bin/dispatch-retry $id \"<補充指示>\" 重派" ;;
      esac
      add_event "$id" "$st" "$task" "$extra" "$guide" >/dev/null
      continue
    fi

    # 11-06 對帳：runner pid 已不在、沒寫 rc（被 kill -9／當機）→ 補 rc=137＋原因，下面照一般 FAIL 出事件
    pidf="$MYTHOS_DIR/state/deep/$id.pid"
    if [ -f "$pidf" ] && [ -f "$MYTHOS_DIR/state/deep/$id.handle" ]; then
      rp="$(tr -d '[:space:]' < "$pidf" 2>/dev/null)"
      case "$rp" in ''|*[!0-9]*) ;; *)
        if ! kill -0 "$rp" 2>/dev/null && [ $((now - $(mtime_of "$pidf"))) -ge $((GONE_MIN * 60)) ] && [ ! -e "$rcfile" ]; then
          printf 'runner 行程已不在（pid %s），沒寫 rc（對帳）\n' "$rp" > "$MYTHOS_DIR/state/deep/$id.handoff" 2>/dev/null
          if ( set -o noclobber; printf '137\n' > "$rcfile" ) 2>/dev/null; then log "對帳：$id runner pid $rp 已不在，補 rc=137"; fi
          continue
        fi ;;
      esac
    fi

    # no rc yet
    stall_min="$DEEP_STALL_MIN"
    review_min="$DEEP_REVIEW_MIN"
    slug="$(slug_of "$cwd")"
    dir="$CLAUDE_PROJECTS_DIR/$slug"
    latest_jsonl=""
    if [ -d "$dir" ]; then
      latest_jsonl="$(ls -t "$dir"/*.jsonl 2>/dev/null | head -1)"
    fi

    max_mtime=0
    if [ -n "$latest_jsonl" ] && [ -f "$latest_jsonl" ]; then
      m="$(mtime_of "$latest_jsonl")"; [ -n "$m" ] && max_mtime="$m"
    fi
    if [ -f "$outfile" ]; then
      m="$(mtime_of "$outfile")"; [ -n "$m" ] && [ "$m" -gt "$max_mtime" ] 2>/dev/null && max_mtime="$m"
    fi

    stall_reported=0
    if [ "$max_mtime" -gt 0 ]; then
      age=$((now - max_mtime))
      if [ "$age" -ge $((stall_min * 60)) ]; then
        last_stall_file="$MYTHOS_DIR/state/deep/$id.last-stall"
        allow=1
        if [ -f "$last_stall_file" ]; then
          last="$(tr -d '[:space:]' < "$last_stall_file")"
          case "$last" in
            ''|*[!0-9]*) allow=1 ;;
            *) if [ $((now - last)) -lt $((stall_min * 60)) ]; then allow=0; fi ;;
          esac
        fi
        if [ "$allow" = 1 ]; then
          guide="判斷是否卡死；卡死就 bin/dispatch-cancel $id 再 bin/dispatch-retry"
          add_event "$id" STALL "$task" "" "$guide" >/dev/null || late=1
          todo "$last_stall_file" "$now"
          stall_reported=1
        fi
      fi
    fi

    if [ "$stall_reported" = 0 ]; then
      last_review_file="$MYTHOS_DIR/state/deep/$id.last-review"
      baseline="$epoch"
      case "$baseline" in ''|*[!0-9]*) baseline="$now" ;; esac
      if [ -f "$last_review_file" ]; then
        lr="$(tr -d '[:space:]' < "$last_review_file")"
        case "$lr" in ''|*[!0-9]*) ;; *) baseline="$lr" ;; esac
      fi
      age_review=$((now - baseline))
      if [ "$age_review" -ge $((review_min * 60)) ]; then
        # 這裡只收集候選；judge 放到終態事件投遞完之後才跑（P1，11-04：抽查不得先於終態投遞）
        # progress
        progress=""
        if [ -n "$latest_jsonl" ] && [ -f "$latest_jsonl" ]; then
          while IFS=$'\t' read -r tname tval; do
            [ -n "$tname" ] || continue
            short="${tval:0:60}"
            item="$tname $short"
            if [ -z "$progress" ]; then progress="$item"; else progress="${progress}；${item}"; fi
          done < <(jq -r 'select(.type=="assistant" and .message) | .message.content[]? | select(.type=="tool_use") | [.name, (.input.file_path // .input.command // .input.path // "")] | @tsv' "$latest_jsonl" 2>/dev/null | tail -n 8)
        fi
        if [ -z "$progress" ]; then progress="讀不到進度"; fi
        progress="${progress:0:500}"
        progress="$(printf '%s' "$progress" | tr '\t\n' '  ')"
        printf '%s\t%s\t%s\t%s\n' "$id" "$task" "$last_review_file" "$progress" >> "$REVIEWS"
      fi
    fi
    continue
  fi

  # 11-06：bg／bg-hard 不是 dcq 單，已由上面 1a 段處理；不得落到下面「dcq 單不在任何佇列」對帳（bg-2157532a 誤判）
  case "$backend" in bg|bg-hard) continue ;; esac
  # dcq row：這張票已有終態事件（不論 ACK 沒）就不重新推導
  # （ACK 後 ledger 是 notified-PASS 會跳過；但事件被測試／手動重設回未 ACK 時，舊版每輪多建一筆）
  if [ "$status" = pending ] && jq -e --arg id "$id" 'select(.job_id==$id and (.status=="PASS" or .status=="FAIL" or .status=="TIMEOUT"))' "$EVENTS_FILE" >/dev/null 2>&1; then
    continue
  fi
  if [ -f "$DCQ_HOME/done/$id.job" ]; then
    st=PASS
  elif [ -f "$DCQ_HOME/failed/$id.job" ]; then
    st=FAIL
  elif [ -f "$DCQ_HOME/running/$id.job" ]; then
    case "$epoch" in '' | *[!0-9]*) continue ;; esac
    if [ $((now - epoch)) -ge $((TIMEOUT_MIN * 60)) ]; then
      st=TIMEOUT
    else
      continue
    fi
  elif [ ! -f "$DCQ_HOME/pending/$id.job" ] && case "$epoch" in ''|*[!0-9]*) false ;; *) [ $((now - epoch)) -ge $((GONE_MIN * 60)) ] ;; esac; then
    # 11-06 對帳：done／failed／running／pending 都沒有這張單，超過 GONE_MIN 分鐘 → 當 FAIL
    add_event "$id" FAIL "$task" "dcq 單不在任何佇列（對帳）" "確認是否被手動清掉；要重來 bin/dispatch-retry，不用做 bin/dispatch-close $id superseded \"<理由>\"" >/dev/null
    continue
  else
    continue
  fi
  add_event "$id" "$st" "$task" "" "" >/dev/null
done < <(ledger_fields < "$TSV")

# 2) ACK：transcript 出現 event_id=<id> 的 user 紀錄才算處理完，ledger 才改 notified-*
newest="$(ls -t "$ROUTER_DIR"/*.jsonl 2>/dev/null | head -1)"
# 用 here-string 不用 pipe：while 在 pipeline 裡是子 shell，後面的等待會吊住整支腳本
while IFS=$'\t' read -r eid at; do
  [ -n "$eid" ] || continue
  ledger_events set "$EVENTS_FILE" "$eid" "{\"acked_at\":$at}" >/dev/null
done <<< "$("$NODE_BIN" "$LIB" scan "$EVENTS_FILE" "$newest" 2>/dev/null)"

# 2b) 未收尾檢查（11-06）：FAIL／TIMEOUT 單要有收尾記錄＝帳本 superseded／cancelled／resolved／notified-PASS、
#     closeouts.tsv 有那張（bin/dispatch-close／dispatch-retry 寫）、或同 thread 後面已有別張單（重派）；
#     STALL 單的收尾＝那張單已離開 pending 或 closeouts 有記。事件超過 UNRESOLVED_HOURS 小時還沒收尾 → 升級一筆 UNRESOLVED 事件
#     （走一般投遞，Router 會派 dispatcher 收尾）；同一張至多 UNRESOLVED_MAX 次，用完寫 brief-lines 一次就停。
unresolved_scan() {
  [ -f "$EVENTS_FILE" ] || return 0
  local lim=$((now - UNRESOLVED_HOURS * 3600)) rows jid kind created row st th ep task closed later cnt last
  rows="$(ledger_fields < "$TSV")"
  while IFS=$'\t' read -r jid kind created; do
    [ -n "$jid" ] || continue
    row="$(printf '%s\n' "$rows" | awk -F'\t' -v i="$jid" '$1==i{print;exit}')"
    [ -n "$row" ] || continue
    st="$(printf '%s' "$row" | cut -f5)"; ep="$(printf '%s' "$row" | cut -f4)"
    th="$(printf '%s' "$row" | cut -f7)"; task="$(printf '%s' "$row" | cut -f3)"
    closed=0
    if [ -f "$CLOSEOUTS" ] && cut -f1 "$CLOSEOUTS" | grep -qxF -- "$jid"; then closed=1; fi
    if [ "$closed" = 0 ]; then
      case "$kind" in
        STALL) [ "$st" = pending ] || closed=1 ;;
        *)
          case "$st" in superseded|cancelled|resolved|notified-PASS|retried) closed=1 ;; esac
          if [ "$closed" = 0 ] && [ -n "$th" ] && [ "$th" != - ]; then
            later="$(printf '%s\n' "$rows" | awk -F'\t' -v t="$th" -v i="$jid" -v e="$ep" '$7==t && $1!=i && $4+0>e+0 {c++} END{print c+0}')"
            [ "$later" -gt 0 ] && closed=1
          fi ;;
      esac
    fi
    [ "$closed" = 1 ] && continue
    cnt="$(jq -r --arg j "$jid" 'select(.job_id==$j and .status=="UNRESOLVED") | .created' "$EVENTS_FILE" | wc -l | tr -d ' ')"
    last="$(jq -r --arg j "$jid" 'select(.job_id==$j and .status=="UNRESOLVED") | .created' "$EVENTS_FILE" | sort -n | tail -1)"
    if [ "$cnt" -ge "$UNRESOLVED_MAX" ]; then
      if [ ! -f "$MYTHOS_DIR/state/.unresolved-capped.$jid" ]; then
        mkdir -p "$BRIEF_LINES_DIR" 2>/dev/null &&
          printf '%s 失敗單升級 %s 次仍未收尾 %s\n' "$(TZ=Asia/Taipei date '+%F %H:%M')" "$cnt" "$jid" >> "$BRIEF_LINES_DIR/mythos-unresolved.txt"
        : > "$MYTHOS_DIR/state/.unresolved-capped.$jid"
        log "unresolved capped $jid"
      fi
      continue
    fi
    [ -n "$last" ] && [ $((now - last)) -lt $((UNRESOLVED_HOURS * 3600)) ] && continue
    add_event "$jid" UNRESOLVED "$task" "$kind 單超過 ${UNRESOLVED_HOURS} 小時沒有收尾記錄（第 $((cnt + 1)) 次提醒）" \
      "確認有人處理：要重做 bin/dispatch-retry $jid \"<補充>\"；不用做 bin/dispatch-close [--quiet] $jid superseded \"<理由>\"；已解決或已告知 bin/dispatch-close $jid done|informed \"<結果>\"（預設推一行給使用者，重複殘留單加 --quiet）" >/dev/null && log "unresolved escalate $jid ($kind)"
  done < <(jq -rs --argjson lim "$lim" '[.[] | select((.status=="FAIL" or .status=="TIMEOUT" or .status=="STALL") and .cancelled != true and .created <= $lim)]
      | group_by(.job_id)[] | (map(select(.status != "STALL"))[0] // .[0]) | [.job_id, .status, .created] | @tsv' "$EVENTS_FILE" 2>/dev/null)
}
unresolved_scan

# 3) 待送：未 ACK 且（沒送過 or 送過超過 10 分鐘），tries 未滿上限
pending_events() {
  [ -f "$EVENTS_FILE" ] || return 0
  # 已取消的票不投遞：ledger 標 cancelled 的 job、cancel 時標 cancelled:true 的事件都排除
  cancelled="$(jq -Rr 'split("\t") | select(.[4]=="cancelled") | .[0]' "$TSV" 2>/dev/null | jq -R . | jq -sc . || echo '[]')"
  jq -rc --argjson now "$now" --argjson resend "$RESEND_SEC" --argjson max "$MAX_TRIES" --argjson cxl "$cancelled" '
    select(.acked_at == null and .tries < $max and .cancelled != true and .direct != "sending")
    | select(.job_id as $j | ($cxl | index($j)) == null)
    | select(.delivered_at == null or ($now - .delivered_at) >= $resend)
    | [.event_id, .job_id, .status, .summary, .extra, .guide] | @tsv' "$EVENTS_FILE"
}
sent=0
deliver() {
  pending_events > "$TODOS.pend"
  if [ -s "$TODOS.pend" ]; then
    pane="$("$TMUX_BIN" -L mythos capture-pane -p -t mythos 2>/dev/null)" || pane=''
    if ! printf '%s\n' "$pane" | tail -15 | grep -q 'esc to interrupt'; then
      parts=''
      sent_ids=''
      while IFS=$'\t' read -r eid jid st sum extra guide; do
        [ -n "$eid" ] || continue
        th="$(jq -r --arg j "$jid" 'select(.job_id==$j) | .thread // "-"' "$EVENTS_FILE" | head -1)"
        case "$th" in ''|null) th=- ;; *[!A-Za-z0-9-]*) th=- ;; esac
        item="[派工回報] event_id=$eid thread=$th $jid $st $sum"
        if [ -n "$extra" ]; then item="${item}；${extra}"; fi
        if [ -n "$guide" ]; then item="${item}；${guide}"; fi
        if [ -z "$parts" ]; then parts="$item"; else parts="${parts}；${item}"; fi
        sent_ids="${sent_ids}${eid}"$'\n'
      done < "$TODOS.pend"
      # 11-06 ctx-guard：未標出的超限事件附在這則回報後面（不單推 TG）
      cnotes="$("$CTX_GUARD" notices 2>/dev/null </dev/null 9>&- | tr '\n' '；')"
      if [ -n "$parts" ] && [ -n "$cnotes" ]; then parts="${parts}；[context 守衛] ${cnotes}"; fi
      if [ -n "$parts" ] && "$TMUX_BIN" -L mythos send-keys -t mythos -l -- "$parts" \
         && "$TMUX_BIN" -L mythos send-keys -t mythos Enter; then
        ledger_events bump "$EVENTS_FILE" "$sent_ids" >/dev/null
        [ -n "$cnotes" ] && "$CTX_GUARD" ack-notices >/dev/null 2>&1 </dev/null 9>&-
        sent=1
      fi
    fi
  fi
  rm -f "$TODOS.pend"
}
# 3a) 先投遞終態（PASS／FAIL／TIMEOUT）與 STALL，不等抽查
deliver

# 3b) 抽查：終態投遞完才跑 judge，總預算 JUDGE_BUDGET 秒（從這裡開始算）。
#   judge 自己有 80s 上限，這裡再用 timeout／gtimeout 包一層硬砍（整個 process group）。
#   兩者都沒有就不跑 judge，事件照舊以 REVIEW 投遞（不吞），log 記 WARN。
if [ -s "$REVIEWS" ]; then
  to_bin=''
  if command -v timeout >/dev/null 2>&1; then to_bin=timeout
  elif command -v gtimeout >/dev/null 2>&1; then to_bin=gtimeout
  fi
  jstart="$(date +%s)"
  while IFS=$'\t' read -r id task last_review_file progress; do
    [ -n "$id" ] || continue
    budget=$(( JUDGE_BUDGET - ( $(date +%s) - jstart ) ))
    # 預算用完：這張這輪不抽查（不建事件、不動 last-review），下輪再判
    [ "$budget" -gt 0 ] || continue
    verdict=""
    if [ -x "$REVIEW_JUDGE" ]; then
      if [ -z "$to_bin" ]; then
        log "WARN no timeout, judge skipped $id"
      # 不接 pipe：judge 非零退出要算失敗（照舊喚醒），不能被 head 的 0 蓋掉
      elif verdict="$("$to_bin" -k 5 "$budget" "$REVIEW_JUDGE" "$task" "$progress" </dev/null 2>/dev/null 9>&-)"; then
        verdict="$(printf '%s\n' "$verdict" | head -1)"
      else
        verdict=""
      fi
    fi
    case "$verdict" in
      ON_TRACK*)
        # 沒跑歪就不吵 Mythos；間隔立刻往前，下一輪才重判（省免費模型呼叫）
        printf '%s\n' "$now" > "$last_review_file"
        continue
        ;;
    esac
    extra="$progress"
    if [ -n "$verdict" ]; then extra="${verdict}｜${progress}"; fi
    guide="對照工單目標判斷有無跑歪；歪了就 bin/dispatch-cancel $id 再 bin/dispatch-retry $id \"<導正指示>\"，沒歪不用回覆"
    add_event "$id" REVIEW "$task" "$extra" "$guide" >/dev/null || late=1
    todo "$last_review_file" "$now"
  done < "$REVIEWS"
  # 3c) 投遞抽查事件
  deliver
fi

# 4) 送出成功才套用 last-* 間隔（pane 忙／送失敗留著下輪；同類型已有未 ACK 事件也先記，免得每輪重判）
if [ -s "$TODOS" ] && { [ "$sent" = 1 ] || [ "$late" = 1 ]; }; then
  while IFS=$'\t' read -r f v; do
    [ -n "$f" ] || continue
    printf '%s\n' "$v" > "$f"
  done < "$TODOS"
fi

# 5) ledger 整檔替換：以事件為準決定 notified-<status>，全程在共同鎖內（D）
ledger_lock || exit 0
{
  while IFS= read -r line || [ -n "$line" ]; do
    id="$(printf '%s\n' "$line" | cut -f1)"
    status="$(printf '%s\n' "$line" | cut -f5)"
    new=''
    if [ "$status" = pending ] && [ -f "$EVENTS_FILE" ]; then
      act="$(jq -r --arg id "$id" 'select(.job_id==$id and .acked_at != null) | .status' "$EVENTS_FILE" | tail -1)"
      case "$act" in
        PASS) new=notified-PASS ;;
        FAIL) new=notified-FAIL ;;
        TIMEOUT) new=timeout-notified ;;
      esac
    fi
    if [ -n "$new" ]; then
      line="$(printf '%s\n' "$line" | awk -F'\t' -v s="$new" 'BEGIN { OFS="\t" } { NF=8; $5=s; print }')"
    fi
    # 舊列不改寫：只有狀態變的才補成 8 欄，其餘原樣寫回
    printf '%s\n' "$line" >> "$OUT"
  done < "$TSV"
  mv "$OUT" "$TSV"
}
ledger_unlock
