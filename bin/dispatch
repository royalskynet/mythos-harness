#!/usr/bin/env bash
# 派工入口：寫好工單後呼叫。路由只看難度，不分急緩（11-02 使用者定）：
#   easy／mid → dcq 派of（DCQ_ORDER=free，只走免費層，全敗就 FAIL 回報，不扣訂閱）
#   hard      → deep（OpenCode Go 訂閱，背景多步自主）
# 用法：bin/dispatch <task.md 絕對路徑> <cwd 絕對路徑> <easy|mid|hard>
# 舊的第四參數（urgent／later）照收不理，免得還沒重開的 Mythos 派工被 exit 2 擋掉。
# DISPATCH_THREAD=<代號>（B）：同一個 thread 的追問／重派都帶同一個代號；沒給就寫 -。
set -u

MYTHOS_DIR="${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# dcq 來自 orchestrator（github.com/royalskynet/orchestrator）
DCQ="${DCQ_BIN:-$(command -v dcq || echo "$HOME/.local/bin/dcq")}"
thread="${DISPATCH_THREAD:-}"
case "$thread" in ''|-|*[!A-Za-z0-9-]*) thread=- ;; esac
. "$ROOT_DIR/bin/lib-ledger.sh"

task="${1:-}"
cwd="${2:-}"
tier="${3:-}"

if [ -z "$task" ] || [ -z "$cwd" ] || [ -z "$tier" ]; then
  echo "用法：bin/dispatch <task.md 絕對路徑> <cwd 絕對路徑> <easy|mid|hard>" >&2
  exit 2
fi

case "$tier" in
  easy | mid | hard) ;;
  *) echo "難度只能是 easy／mid／hard：$tier" >&2; exit 2 ;;
esac

if [ "$tier" = hard ]; then route=deep; else route=dcq; export DCQ_ORDER=free; fi
if [ "$route" = deep ]; then
  epoch="$(date +%s)"
  base="$(basename "$task")"
  name="${base%.md}"
  id="deep-${epoch}-${name}"
  mkdir -p "$MYTHOS_DIR/state" "$MYTHOS_DIR/state/deep"
  nohup "$ROOT_DIR/bin/dispatch-deep-run" "$id" "$task" "$cwd" >/dev/null 2>&1 &
  row="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$id" "$tier" "$task" "$epoch" pending "$cwd" "$thread" deep)"
  # 已啟動才拿不到鎖：不能直接退出把這張票弄丟，不持鎖追加並記 WARN 到 logs/dispatch.log
  if ! ledger_lock; then
    mkdir -p "$MYTHOS_DIR/logs"
    printf '%s %s\n' "$(date '+%F %T')" "WARN unlocked append $id" >> "$MYTHOS_DIR/logs/dispatch.log"
    printf '%s\n' "$row" >> "$MYTHOS_DIR/state/dispatch-jobs.tsv"
    echo "$id"
    exit 0
  fi
  printf '%s\n' "$row" >> "$MYTHOS_DIR/state/dispatch-jobs.tsv"
  ledger_unlock
  echo "$id"
  exit 0
fi

id="$("$DCQ" add "$task" "$cwd" "$tier")" || {
  rc=$?
  echo "dcq add 失敗（exit ${rc}）：${task}" >&2
  exit "$rc"
}

id="$(printf '%s\n' "$id" | tail -1 | tr -d '[:space:]')"
if [ -z "$id" ]; then
  echo "dcq add 沒有回傳 job id" >&2
  exit 1
fi

mkdir -p "$MYTHOS_DIR/state"
# 統一 8 欄（D）：id tier task epoch status cwd thread backend。
# 第 6 欄 cwd：dispatch-retry 靠它重派（11-03 Codex 審計：O 列少這欄，retry 一律「找不到 cwd」）
row="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$id" "$tier" "$task" "$(date +%s)" pending "$cwd" "$thread" dcq)"
# dcq 已經接手這張票：拿不到鎖也不退出，不持鎖追加並記一行 WARN（鎖本身幾乎不會壞，壞了也不能丟登錄）
if ! ledger_lock; then
  mkdir -p "$MYTHOS_DIR/logs"
  printf '%s %s\n' "$(date '+%F %T')" "WARN unlocked append $id" >> "$MYTHOS_DIR/logs/dispatch.log"
  printf '%s\n' "$row" >> "$MYTHOS_DIR/state/dispatch-jobs.tsv"
else
  printf '%s\n' "$row" >> "$MYTHOS_DIR/state/dispatch-jobs.tsv"
  ledger_unlock
fi

"$DCQ" start -j 4 >/dev/null 2>&1 || true

echo "$id"
