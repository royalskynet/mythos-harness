#!/usr/bin/env bash
# 派工入口：寫好工單後呼叫。路由只看難度，不分急緩（11-02 使用者定）：
#   easy → dcq 派of（DCQ_ORDER=free，只走免費層，全敗就 FAIL 回報）
#   mid  → dcq 派o（DCQ_ORDER=default：免費先、全敗升訂閱，11-07 使用者定改回免費優先；要訂閱首棒設 DISPATCH_MID_ORDER=sub，只用免費設 =free）
#   hard → dcq 派o（DCQ_ORDER=default：免費先、全敗升訂閱，11-07 使用者定：不派 Claude 付費子代理）；
#          DISPATCH_HARD_BACKEND=bg 回 bg-hard（claude --bg，sonnet＋Opus advisor）、=deep 回舊的 deep-run
# 用法：bin/dispatch <task.md 絕對路徑> <cwd 絕對路徑> <easy|mid|hard>
# 舊的第四參數（urgent／later）照收不理，免得還沒重開的 Mythos 派工被 exit 2 擋掉。
# DISPATCH_THREAD=<代號>（B）：同一個 thread 的追問／重派都帶同一個代號；沒給就寫 -。
set -u

MYTHOS_DIR="${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# dcq 來自 orchestrator（github.com/royalskynet/orchestrator）
DCQ="${DCQ_BIN:-$(command -v dcq || echo "$HOME/.local/bin/dcq")}"
thread="${DISPATCH_THREAD:-}"
case "$thread" in ''|-|*[!A-Za-z0-9-]*) thread=- ;; esac
. "$ROOT_DIR/bin/lib-ledger.sh"

task="${1:-}"
cwd="${2:-}"
tier="${3:-}"

if [ -z "$task" ] || [ -z "$cwd" ] || [ -z "$tier" ]; then
  echo "用法：bin/dispatch <task.md 絕對路徑> <cwd 絕對路徑> <easy|mid|hard>" >&2
  exit 2
fi
# 相對路徑一律轉絕對（deep-run 拒收相對路徑，11-06 bk-binance-relogin）
case "$task" in /*) ;; *) [ -f "$task" ] && task="$(cd "$(dirname "$task")" && pwd)/$(basename "$task")" ;; esac

case "$tier" in
  easy | mid | hard) ;;
  *) echo "難度只能是 easy／mid／hard：$tier" >&2; exit 2 ;;
esac

# 驗收路徑過期守門（拍 pin 之前）：驗收引用的檔案／glob 已不存在就不派，STALE 行原樣轉出。
# 只有 exit 1（STALE）拒派；2（無驗收區塊）等其它 rc 照舊放行。LINT_SKIP=1 略過（測試用）。
if [ "${LINT_SKIP:-}" != 1 ]; then
  lint_out="$("$ROOT_DIR/bin/accept-paths-lint" "$task" 2>&1)"
  lint_rc=$?
  if [ "$lint_rc" -eq 1 ]; then
    printf '%s\n' "$lint_out" | grep '^STALE: ' >&2
    echo "驗收引用的路徑已過期，拒派：${task}" >&2
    exit 1
  fi
fi

# hard 預設走 O（11-07）；DISPATCH_HARD_BACKEND=bg 才走 bg-hard（獨立 claude --bg session），=deep 走舊的 deep-run
hard_backend="${DISPATCH_HARD_BACKEND:-o}"
if [ "$tier" = hard ] && [ "$hard_backend" = bg ]; then
  # 新開一個 session（不帶 --thread 續派：呼叫端常是同 thread 的 worker 自己，續派會續到它自己身上）；
  # cwd 交給 dispatch-bg 寫進 prompt 第一行（git worktree add），bg-hard 不進 C3 repo 佇列
  exec "${DISPATCH_BG_BIN:-$ROOT_DIR/bin/dispatch-bg}" --hard --cwd "$cwd" "$thread" "$task"
fi
case "$tier:$hard_backend" in
  hard:deep) route=deep ;;
  hard:*) route=dcq; export DCQ_ORDER="${DISPATCH_HARD_ORDER:-default}" ;;
  mid:*) route=dcq; export DCQ_ORDER="${DISPATCH_MID_ORDER:-default}" ;;
  *) route=dcq; export DCQ_ORDER=free ;;
esac
# 規劃單（bin/plan-ticket 產，第一行 then-run 標記）派 dcq 不可進 worktree、不可防空轉
# （11-07：（1）dcq 暫存 worktree 裡寫的工單，merge 不回來就消失；（2）工作樹沒變化，dcq 420 秒防空轉就殺模型）
if [ -f "$task" ]; then
  first="$(head -n 1 "$task" 2>/dev/null)"
  case "$first" in '<!-- mythos:then-run '*) export DCQ_SPIN_S=0 DCQ_WORKTREE=0 ;; esac
fi
mkdir -p "$MYTHOS_DIR/state"
# 順序（P0，11-04）：持鎖寫 pending 列 → 放鎖 → 才啟動後端。拿不到鎖就什麼都不派，
# 不再有「後端已在跑、ledger 卻沒持鎖就追加」的路徑。
nolock() { echo "拿不到 ledger 鎖，未派出：${task}" >&2; exit 1; }

if [ "$route" = deep ]; then
  epoch="$(date +%s)"
  base="$(basename "$task")"
  name="${base%.md}"
  # 加 $$：同一秒、同檔名（不同目錄）的兩張票由不同行程派出，id 不撞
  id="deep-${epoch}-$$-${name}"
  # DISPATCH_DEEP_RUN_BIN：測試換 runner 的覆寫點（dispatch-watch 拉起 queued 用同一條）
  runner="${DISPATCH_DEEP_RUN_BIN:-$ROOT_DIR/bin/dispatch-deep-run}"
  # 測試守門（F1）：MYTHOS_TEST_SANDBOX 非空時 runner 必須在它底下；不在就先拒跑，ledger 不寫任何列
  if [ -n "${MYTHOS_TEST_SANDBOX:-}" ]; then
    case "$runner" in
      "$MYTHOS_TEST_SANDBOX"/*) ;;
      *) echo "測試模式拒跑真 runner" >&2; exit 97 ;;
    esac
  fi
  mkdir -p "$MYTHOS_DIR/state/deep"
  ledger_lock || nolock
  # 同 repo 佇列（C3）：持鎖後才查，兩張同時派不會都看到「沒人在跑」。
  # 同 top 已有 pending／queued、未寫 rc 的 deep 票 → 本列寫 queued、不啟動 runner（由 dispatch-watch 拉起）。
  # DISPATCH_REPO_QUEUE=0 關掉（只給測單票生命週期的舊測試用；佇列行為由 tests/test-repo-queue.sh 驗）
  st=pending
  queued=''
  if [ "${DISPATCH_REPO_QUEUE:-1}" != 0 ] && [ -f "$MYTHOS_DIR/state/dispatch-jobs.tsv" ]; then
    top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null 9>&- || printf %s "$cwd")"
    while IFS=$'\t' read -r oid _ _ _ ost ocwd _ obackend; do
      # F4：queued 也算有人在跑，否則新票插隊、queued 永遠拉不起來
      case "$ost" in pending|queued) ;; *) continue ;; esac
      [ "$obackend" = deep ] || continue
      [ -f "$MYTHOS_DIR/state/deep/$oid.rc" ] && continue
      otop="$(git -C "$ocwd" rev-parse --show-toplevel 2>/dev/null 9>&- || printf %s "$ocwd")"
      [ "$otop" = "$top" ] && { queued="$oid"; break; }
    done < <(ledger_fields < "$MYTHOS_DIR/state/dispatch-jobs.tsv")
  fi
  [ -n "$queued" ] && st=queued
  row="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$id" "$tier" "$task" "$epoch" "$st" "$cwd" "$thread" deep)"
  printf '%s\n' "$row" >> "$MYTHOS_DIR/state/dispatch-jobs.tsv" || { ledger_unlock; echo "寫 ledger 失敗，未派出：${task}" >&2; exit 1; }
  ledger_unlock
  if [ -n "$queued" ]; then
    echo "同 repo 有票在跑，已排隊：${queued}" >&2
    echo "$id"
    exit 0
  fi
  handle="$MYTHOS_DIR/state/deep/$id.handle"
  # 9>&-：長壽子行程不繼承 ledger 鎖的 fd（這裡已放鎖，仍防呆）
  nohup "$runner" "$id" "$task" "$cwd" >/dev/null 2>&1 9>&- &
  # 等 runner 寫好 handle 才回：派完馬上 cancel 也有 handle 可用（最多約 5 秒）
  n=0
  while [ ! -s "$handle" ] && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
  [ -s "$handle" ] || echo "警告：runner 沒在 5 秒內寫好 handle：$handle" >&2
  echo "$id"
  exit 0
fi

# 測試守門（F1）：sandbox 非空時 dcq 也必須在 sandbox 裡（11-07：hard 改走 O 後有測試打到真 dcq）
if [ -n "${MYTHOS_TEST_SANDBOX:-}" ]; then
  case "$DCQ" in "$MYTHOS_TEST_SANDBOX"/*) ;; *) echo "測試模式拒跑真 runner" >&2; exit 97 ;; esac
fi
# dcq 的 id 由 dcq add 回傳：持鎖期間呼叫 dcq add 並寫列（dcq add 是秒級）
# 11-07 使用者：Mythos 派的單是付費告警例外。dc 看到這行只落帳不發 TG；寫在檔尾，第一行留給 then-run 標記
grep -qx '<!-- dc:billing-quiet -->' "$task" || printf '\n<!-- dc:billing-quiet -->\n' >> "$task"
ledger_lock || nolock
id="$("$DCQ" add "$task" "$cwd" "$tier" 9>&-)" || {
  rc=$?
  ledger_unlock
  echo "dcq add 失敗（exit ${rc}）：${task}" >&2
  exit "$rc"
}

id="$(printf '%s\n' "$id" | tail -1 | tr -d '[:space:]')"
if [ -z "$id" ]; then
  ledger_unlock
  echo "dcq add 沒有回傳 job id" >&2
  exit 1
fi

# 統一 8 欄（D）：id tier task epoch status cwd thread backend。
# 第 6 欄 cwd：dispatch-retry 靠它重派（11-03 Codex 審計：O 列少這欄，retry 一律「找不到 cwd」）
row="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$id" "$tier" "$task" "$(date +%s)" pending "$cwd" "$thread" dcq)"
printf '%s\n' "$row" >> "$MYTHOS_DIR/state/dispatch-jobs.tsv" || {
  ledger_unlock
  echo "寫 ledger 失敗：${id}（dcq 已收件，用 dcq cancel ${id} 撤回）" >&2
  exit 1
}
ledger_unlock

"$DCQ" start -j 4 >/dev/null 2>&1 9>&- || true

echo "$id"
