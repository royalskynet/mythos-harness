#!/bin/sh
# 每日閒置重置（OpenClaw session.reset 的對等版）。launchd 每天 04:00／05:00／06:00 跑，零 token，一天只清一次。
# 條件：pane 沒在跑（無「esc to interrupt」）且最新 transcript ≥ IDLE_MIN 分鐘沒動 → 送 /clear（同 tg-commands 的 /new）。
# /clear 會觸發 SessionEnd hook → daily-log 先把對話摘要進日誌，新 session 開場再由 session-context 載回。
# 11-02 改：舊條件「6 小時沒動」永遠不成立——夜間排程 03:00 會叫 Router 寫計畫，
# 於是每天 04:00 都判 active。改成短閒置＋多試幾個整點，Router 還在寫就等下一點。
IDLE_MIN=${IDLE_MIN:-30}
TMUX=${TMUX_BIN:-/opt/homebrew/bin/tmux}
BOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
# Claude Code 的 transcript 目錄＝工作目錄路徑把非英數字換成 -
PROJ=${PROJ:-$HOME/.claude/projects/$(printf '%s' "$BOT_DIR" | sed 's/[^A-Za-z0-9]/-/g')}
STAMP=${STAMP:-$(dirname "$0")/../state/idle-reset.stamp}
today=$(date +%F)
[ "$(cat "$STAMP" 2>/dev/null)" = "$today" ] && { echo "$(date '+%F %T') already cleared today -> skip"; exit 0; }
T=$(ls -t "$PROJ"/*.jsonl 2>/dev/null | head -1)
[ -n "$T" ] || exit 0
age=$(( ($(date +%s) - $(stat -f %m "$T")) / 60 ))
# 先單獨抓 pane：抓不到＝不知道忙不忙，不能當閒置送鍵（11-02 Codex 審計）
if ! pane=$($TMUX -L mythos capture-pane -p -t mythos 2>/dev/null); then
  echo "$(date '+%F %T') capture-pane failed -> keep"
elif printf '%s\n' "$pane" | grep -q 'esc to interrupt'; then
  echo "$(date '+%F %T') busy (pane running) -> keep"
elif [ "$age" -lt "$IDLE_MIN" ]; then
  echo "$(date '+%F %T') active (${age}m) -> keep"
else
  $TMUX -L mythos send-keys -t mythos -l '/clear' && $TMUX -L mythos send-keys -t mythos Enter && printf '%s\n' "$today" > "$STAMP"
  echo "$(date '+%F %T') idle ${age}m -> /clear"
fi
