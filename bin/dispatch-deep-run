#!/usr/bin/env bash
# deep 票的 runner：跑 deep-run、記 rc，並寫 state/deep/<id>.handle 給 dispatch-cancel 精確取消。
# handle（key=value 每行一筆）：
#   pid=<本 runner pid>  deep_pid=<deep-run pid>  session=<deep-run 開的 tmux session 名>
#   pid_start／deep_pid_start＝ps -o lstart=（pid 會被重用，cancel 送訊號前比對，失配就不殺）
# deep-run 的 tmux session 名＝deep-<秒數>-<deep-run 自己的 pid>，它同時寫 <秒數>-<pid>-task.md；
# 這裡用 deep_pid 對檔名找出 session 名，不靠工單內容或時間猜。
set -u

# 測試守門（F1）：測試環境帶 MYTHOS_TEST_SANDBOX 時，下一層 deep-run 必須是 sandbox 內的 stub；
# 沒設（＝會跑真 deep-run）或指到 sandbox 外一律拒跑，什麼檔都不寫
if [ -n "${MYTHOS_TEST_SANDBOX:-}" ]; then
  case "${DEEP_RUN_BIN:-}" in
    "$MYTHOS_TEST_SANDBOX"/*) ;;
    *) echo "測試模式拒跑真 runner" >&2; exit 97 ;;
  esac
fi

MYTHOS_DIR="${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
DEEP_TASK_DIR="${DEEP_TASK_DIR:-${DC_HOME:-$HOME/.deepclaude}/work/.deep}"
TSV="$MYTHOS_DIR/state/dispatch-jobs.tsv"

id="${1:-}"
task="${2:-}"
cwd="${3:-}"

if [ -z "$id" ] || [ -z "$task" ] || [ -z "$cwd" ]; then
  echo "用法：bin/dispatch-deep-run <id> <task> <cwd>" >&2
  exit 2
fi

# 原子寫 handle：先寫暫存再 mv，cancel 不會讀到半份
write_handle() {
  printf '%s\n' "$@" > "$handle.tmp.$$" && mv "$handle.tmp.$$" "$handle"
}
# lstart 原樣寫（含連續空白），dispatch-cancel 用同一個 ps 格式逐字比對
start_of() { ps -o lstart= -p "$1" 2>/dev/null; }

mkdir -p "$MYTHOS_DIR/state/deep"
out="$MYTHOS_DIR/state/deep/$id.out"
rcf="$MYTHOS_DIR/state/deep/$id.rc"
pidf="$MYTHOS_DIR/state/deep/$id.pid"
handle="$MYTHOS_DIR/state/deep/$id.handle"

# F1：票已落地（rc 寫了，或 ledger 該列不是 pending）就不啟動遲到的 runner。直呼測試沒有 ledger 列，照舊跑。
#   檢查與第一版 handle 同一把鎖：第 1 步看到 handle 才不會先判成啟動失敗（F2）。
. "$(cd "$(dirname "$0")" && pwd)/lib-ledger.sh"
ledger_lock || exit 75
if [ -f "$rcf" ] || { [ -f "$TSV" ] && awk -F'\t' -v id="$id" '$1==id { NF=8; print $5; exit }' "$TSV" | grep -qv '^pending$'; }; then
  ledger_unlock
  echo "票已落地，不啟動：$id" >&2
  exit 0
fi
: > "$out"
printf '%s\n' "$$" > "$pidf"
write_handle "pid=$$" "pid_start=$(start_of $$)"
ledger_unlock

"${DEEP_RUN_BIN:-deep-run}" "$task" "$cwd" > "$out" 2>&1 &
dp=$!
write_handle "pid=$$" "pid_start=$(start_of $$)" "deep_pid=$dp" "deep_pid_start=$(start_of "$dp")"

# 最多等 10 秒找 deep-run 開的 session（deep-run 一開始就寫 task 檔再開 tmux）
session=''
n=0
while [ "$n" -lt 50 ] && kill -0 "$dp" 2>/dev/null; do
  for f in "$DEEP_TASK_DIR"/*-"$dp"-task.md; do
    [ -f "$f" ] || continue
    # pid 會被重用：比本 runner 啟動還舊的同 pid task 檔是別人的
    [ "$pidf" -nt "$f" ] && continue
    b="$(basename "$f")"
    session="deep-${b%-task.md}"
    break
  done
  [ -n "$session" ] && break
  sleep 0.2
  n=$((n + 1))
done
if [ -n "$session" ]; then
  write_handle "pid=$$" "pid_start=$(start_of $$)" "deep_pid=$dp" "deep_pid_start=$(start_of "$dp")" "session=$session"
fi

wait "$dp"
rc=$?
printf '%s\n' "$rc" > "$rcf"
exit "$rc"
