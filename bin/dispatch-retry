#!/usr/bin/env bash
set -u

MYTHOS_DIR="${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TSV="$MYTHOS_DIR/state/dispatch-jobs.tsv"
. "$ROOT_DIR/bin/lib-ledger.sh"

id="${1:-}"
extra="${2:-}"

if [ -z "$id" ] || [ -z "$extra" ]; then
  echo "用法：bin/dispatch-retry <id> \"<補充指示>\"" >&2
  exit 2
fi

if [ ! -f "$TSV" ]; then
  echo "找不到 $TSV" >&2
  exit 1
fi

row="$(awk -F'\t' -v id="$id" '$1 == id { print; exit }' "$TSV")"
if [ -z "$row" ]; then
  echo "找不到工單：$id" >&2
  exit 1
fi

row="$(printf '%s\n' "$row" | ledger_fields)"
task="$(printf '%s\n' "$row" | cut -f3)"
cwd="$(printf '%s\n' "$row" | cut -f6)"
tier="$(printf '%s\n' "$row" | cut -f2)"
# 沿用原後端（D）：dcq→mid、deep→hard，不再只按 tier 猜；tier 缺／壞才用後端推
backend="$(printf '%s\n' "$row" | cut -f8)"
# dispatch 只看 tier 選後端（hard→deep），所以 tier 要跟著後端：dcq 票不能被舊 tier=hard 帶去 deep
case "$backend:$tier" in
  dcq:easy|dcq:mid) ;;
  dcq:*) tier=mid ;;
  deep:*) tier=hard; export DISPATCH_HARD_BACKEND=deep ;;  # 工單 D：hard 預設改 bg-hard，deep 票重派仍走 deep
  bg-hard:*) tier=hard; export DISPATCH_HARD_BACKEND=bg ;;
  bg:*) echo "bg 票用 bin/dispatch-bg --thread <thread> <prompt檔> 續派，不走 dispatch-retry：$id" >&2; exit 2 ;;
esac
# deep 兜底（11-06，使用者定「派o 沒別的可派才 deep」）：原票是 dcq（mid／easy）、已在 ~/.dcq/failed（免費層全敗，
# 含 Zen 額度用完冷卻）、同題（root）還沒派過 deep、工單沒標 NO-DEEP → 這次改派 deep 一次（deep-run 走 OpenCode Go 訂閱，不碰 API 層）。
# 每題最多一次：ledger 已有同 root 的 deep 票就不再兜底；之後的重派照原後端。關閉：DISPATCH_DEEP_FALLBACK=0。
# 復原：cp dispatch-retry.bak-20261106-deepfb dispatch-retry
DEEP_FB=0
if [ "${DISPATCH_DEEP_FALLBACK:-1}" = 1 ] && [ "$backend" = dcq ] && [ -f "$HOME/.dcq/failed/$id.job" ] \
   && ! grep -q '^CANCELLED=1' "$HOME/.dcq/failed/$id.job" 2>/dev/null; then
  _b="$(basename "$task")"; _r="${_b%.md}"; _r="$(printf '%s' "$_r" | sed 's/-r[0-9][0-9]*$//')"
  _had="$(awk -F'\t' -v r="$_r" '{ t=$3; sub(/.*\//,"",t); sub(/\.md$/,"",t); sub(/-r[0-9]+$/,"",t); b=$8; if (t==r && b=="deep") c++ } END { print c+0 }' "$TSV")"
  if [ "$_had" = 0 ] && [ -f "$task" ] && ! grep -q 'NO-DEEP' "$task" \
     && case "$task" in "$HOME"/.claude/*) false ;; *) true ;; esac; then
    DEEP_FB=1; tier=hard; export DISPATCH_HARD_BACKEND=deep
    echo "deep 兜底：派o 免費層全敗（$id），這題改派 deep 一次" >&2
  fi
fi
# 沿用原 thread（D）；沒有就 - ，同票重派才接得上
thread="$(printf '%s\n' "$row" | cut -f7)"
case "$thread" in ''|-|*[!A-Za-z0-9-]*) thread=- ;; esac
# 25c0ae5 前的 O 列沒記 cwd：當時 dcq 在 Mythos 目錄下被呼叫，照舊補
[ -n "$cwd" ] || cwd="$MYTHOS_DIR"

# root name
base="$(basename "$task")"
root="${base%.md}"
root="$(printf '%s' "$root" | sed 's/-r[0-9][0-9]*$//')"

count="$(awk -F'\t' -v root="$root" '
{
  t=$3; sub(/.*\//,"",t); sub(/\.md$/,"",t); sub(/-r[0-9]+$/,"",t);
  if (t==root) c++
} END { print c+0 }
' "$TSV")"
N="${count:-0}"
if [ "$N" -lt 1 ]; then N=1; fi

if [ "$N" -gt 3 ]; then
  echo "已重派 3 次，回報使用者" >&2
  exit 1
fi

mkdir -p /tmp/dc-worker
newtask="/tmp/dc-worker/${root}-r${N}.md"
ts="$(date '+%Y-%m-%d %H:%M')"
{
  if [ -f "$task" ]; then cat "$task"; else printf '%s\n' "$task"; fi
  printf '\n\n## 追加指示（第 %s 次重派，%s）\n\n%s\n' "$N" "$ts" "$extra"
} > "$newtask"

DISPATCH_THREAD="$thread" "$ROOT_DIR/bin/dispatch" "$newtask" "$cwd" "$tier"
rc=$?
# 11-06：重派成功＝舊票收尾（dispatch-watch 的未收尾檢查看 state/closeouts.tsv）；不推使用者，新票自己會有結果
[ "$rc" = 0 ] && "$ROOT_DIR/bin/dispatch-close" --quiet "$id" retried "dispatch-retry 重派 → ${root}-r${N}" >/dev/null 2>&1
exit "$rc"
