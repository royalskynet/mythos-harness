#!/usr/bin/env python3
"""印 Genie 說話規則（`<genie>/router/prefs.py context` 的輸出），由 Router 外掛 mythos-tools 呼叫。
找 Genie 的順序：MYTHOS_GENIE_DIR → Claude Code 裝的版本（installed_plugins.json 裡 genie-harness 的 user scope
installPath；路徑帶版本號，升級就換，所以每次現查）→ ~/dev/genie-harness。偏好檔 $MYTHOS_DIR/state/genie-prefs.json。
找不到或跑失敗：印空、exit 0，不擋呼叫端。
用法：bin/genie-context            印規則
      bin/genie-context --dir      只印找到的 Genie 目錄"""
import json
import os
import subprocess
import sys

HOME = os.path.expanduser("~")
MYTHOS = os.environ.get("MYTHOS_DIR") or os.path.join(HOME, "bots", "mythos")
INSTALLED = os.environ.get("CLAUDE_INSTALLED_PLUGINS") or os.path.join(HOME, ".claude", "plugins", "installed_plugins.json")


def claude_code_dir() -> str:
    try:
        with open(INSTALLED, encoding="utf-8") as f:
            entries = json.load(f).get("plugins", {}).get("genie-harness@genie-harness", [])
    except (OSError, ValueError, AttributeError):
        return ""
    user = [e for e in entries if isinstance(e, dict) and e.get("scope") == "user"]
    return (user or [e for e in entries if isinstance(e, dict)] or [{}])[0].get("installPath", "")


def genie_dir() -> str:
    for d in (os.environ.get("MYTHOS_GENIE_DIR", ""), claude_code_dir(), os.path.join(HOME, "dev", "genie-harness")):
        if d and os.path.isfile(os.path.join(d, "router", "prefs.py")):
            return d
    return ""


def main() -> int:
    d = genie_dir()
    if "--dir" in sys.argv[1:]:
        print(d)
        return 0
    if not d:
        return 0
    try:
        out = subprocess.run([sys.executable, os.path.join(d, "router", "prefs.py"), "context"],
                             capture_output=True, text=True, timeout=5, stdin=subprocess.DEVNULL,
                             env={**os.environ, "GENIE_PREFS": os.path.join(MYTHOS, "state", "genie-prefs.json")})
    except (OSError, subprocess.SubprocessError):
        return 0
    if out.returncode == 0:
        sys.stdout.write(out.stdout.strip())
    return 0


if __name__ == "__main__":
    sys.exit(main())
