#!/usr/bin/env python3
"""快查線（11-06 使用者定）：唯讀問題丟 opencode run 的免費模型，不派 O、不開 Sonnet 迴圈。
用法：bin/quick <cwd 絕對路徑> <問題…>   （問題也可從 stdin）
- 模型＝bin/free-models（dcq 免費 opencode 層，跟每日 probe／go-sync 同步），依序試，失敗換下一個。
  只走免費層（bin/free-models，隨每日 probe 換；11-07 起不墊訂閱）；要付費墊底才設 QUICK_PAID=<模型>（訂閱＝花錢）。
- macOS sandbox-exec 事前限制寫入與敏感路徑讀取；無此工具的系統警告降級，保留事後稽核。
- 機械稽核 JSON 事件：用了 write／edit／patch 或改狀態的 bash → 整個答案作廢（exit 3）。
- 問題含 PII（錢包／交易雜湊／email／台灣手機／卡號）→ 不出機，exit 4，呼叫端自己查。
- 答案要求每個結論附上跑的指令與原始輸出；呼叫端挑關鍵一條重跑對照，對不上就當沒查到。
依賴：opencode（必要，沒裝 exit 6）；dcq（選用；沒裝或沒列出免費層就 exit 5，不退回寫死的模型名）。
用法加 --push（bin/quick --push <cwd> '<問題>'）：答案交 bin/brief-answer 直送，stdout 只回「已直送」。
exit：0 有答案（stdout）｜2 用法｜3 越界｜4 PII｜5 全部模型失敗｜6 沒裝 opencode（呼叫端改派 dispatcher）
"""
import json, os, re, shutil, subprocess, sys, tempfile

OC = os.environ.get("QUICK_OC") or "opencode"
TIMEOUT = int(os.environ.get("QUICK_TIMEOUT") or 180)
BRIEF = os.environ.get("QUICK_BRIEF") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "brief-answer")
PAID = os.environ.get("QUICK_PAID", "")
PII = re.compile(r"\b0x[0-9a-fA-F]{40}\b|\b0x[0-9a-fA-F]{64}\b|\bbc1[0-9a-z]{25,60}\b|\bT[1-9A-HJ-NP-Za-km-z]{33}\b"
                 r"|[\w.+-]+@[\w-]+\.[\w.]+|(?<![\d.])(?:\+?886|0)9\d{2}-?\d{3}-?\d{3}(?!\d)|\b(?:\d[ -]?){15,16}\b")
# 同 bess-maint MUTATE（只看殼層動作；ponytail: heredoc 內腳本寫檔看不到）
MUTATE = re.compile(r"(^|[;&|(]\s*)(rm|mv|cp|tee|chmod|chown|ln|truncate|kill|pkill|touch|mkdir|dcq(?!\s+(?:rank|plan|status|ls|list|logs?|show|help)\b)|sqlite3(?!\s+-readonly))\s|sed\s+-i|launchctl\s+(bootout|bootstrap|kickstart|load|unload|kill|enable|disable)|git(\s+-C\s+\S+)?\s+(commit|push|reset|checkout|rebase|stash|add|pull|merge)\b|brew\s+(install|upgrade|uninstall)|curl\s+.*-X\s*(POST|PUT|DELETE|PATCH)|(?<![<>=\d-])>{1,2}\s*[~/$\w]")
WRITE_TOOLS = {"write", "edit", "patch", "multiedit", "apply_patch"}
ASK = """你是唯讀快查員。只准讀檔、跑唯讀指令（ls、cat、grep、git log/status/diff、ps、launchctl list、sqlite3 -readonly…），
禁止寫檔、改設定、重啟服務、刪東西、送網路寫入請求。
回答格式：第一行結論；之後每個結論各附「指令」與「原始輸出」（原樣貼，最多 15 行）。查不到就寫「查不到」與你試過的指令，不要猜。

問題：
{q}"""


def models():
    """免費模型清單取 bin/free-models（dcq 免費層）；取不到就空，不退回寫死的名字。"""
    try:
        out = subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), "free-models")],
                             capture_output=True, text=True, timeout=30).stdout
    except Exception:
        out = ""
    return out.split() + ([PAID] if PAID else [])


def audit(events):
    """回傳越界動作清單；空＝乾淨。"""
    bad = []
    for e in events:
        p = e.get("part") or {}
        if e.get("type") != "tool_use":
            continue
        tool = (p.get("tool") or "").lower()
        inp = (p.get("state") or {}).get("input") or {}
        if tool in WRITE_TOOLS:
            bad.append(f"{tool} {inp.get('filePath', '')}".strip())
        elif tool == "bash":
            cmd = inp.get("command") or ""
            rest = re.sub(r"'[^']*'|\"[^\"]*\"", "''", re.split(r"<<-?\s*['\"]?\w+", cmd)[0])
            rest = re.sub(r"\d?>\s*/dev/null|\d>&\d", "", rest)
            if MUTATE.search(rest):
                bad.append(f"bash {cmd[:120]}")
    return bad


def answer(events):
    return "".join((e.get("part") or {}).get("text") or "" for e in events if e.get("type") == "text").strip()


def denied_paths():
    home = os.path.expanduser("~")
    return [os.path.realpath(os.path.expanduser(p)) for p in
            [os.path.join(home, d) for d in (".creds", ".ssh", ".aws", ".gnupg")]
            + os.environ.get("QUICK_DENY_READ", "").split(":") if p]


def sensitive_cwd(cwd):
    paths = {os.path.abspath(cwd), os.path.realpath(cwd)}
    return any(c == p or c.startswith(p + os.sep) for c in paths for p in denied_paths()) or any(
        part.startswith(".env") for c in paths for part in c.split(os.sep))


def sandbox_prefix(cwd):
    """平台原生 Seatbelt；有安裝但套用失敗時不退回無沙箱執行。"""
    sb = "/usr/bin/sandbox-exec"
    if not os.path.isfile(sb):
        print("quick: 警告：沒有 sandbox-exec，降級為事後 JSON 稽核，沒有事前沙箱", file=sys.stderr)
        return []
    home = os.path.expanduser("~")
    writable = [os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(home, ".local/share")), "opencode"),
                os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(home, ".cache")), "opencode"),
                os.environ.get("TMPDIR") or "/tmp"]
    quote = lambda p: json.dumps(os.path.realpath(p), ensure_ascii=False)
    rules = ['(version 1)', '(allow default)', '(deny file-write*)']
    rules += ['(allow file-write* (subpath %s))' % quote(writable[-1]),
              '(deny file-write* (subpath %s))' % quote(cwd)]
    rules += ['(allow file-write* (subpath %s))' % quote(p) for p in writable[:-1]]
    rules += ['(allow file-write* (literal "/dev/null"))']
    rules += ['(deny file-read* (subpath %s))' % quote(p) for p in denied_paths()]
    # SBPL 的 #"…" 不再解跳脫；用 json.dumps 會變成 \\. 對不到 .env（11-07 沙箱外實測）
    rules += ['(deny file-read* (regex #"(^|/)\.env[^/]*(/|$)"))']
    return [sb, "-p", "\n".join(rules)]


def request_stage(stage):
    if re.fullmatch(r"tg:-?\d+:\d+", os.environ.get("MYTHOS_REQUEST_ID", "")):
        here = os.path.dirname(os.path.abspath(__file__))
        try:  # 量測寫入失敗不擋主流程
            subprocess.run([os.environ.get("NODE_BIN", "node"), os.path.join(here, "lib-request.mjs"), "env-log",
                            os.environ.get("MYTHOS_DIR", os.path.dirname(here)), stage], timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass


def clean_config_env():
    """沙箱擋憑證目錄後，opencode 讀到引用檔案的金鑰欄位會整個起不來（11-07 實測）。
    複製一份去掉引用檔案的 provider 與 mcp 的設定，用 XDG_CONFIG_HOME 指過去；免費模型不靠這些金鑰。
    順便加 opencode 原生權限當第一層：改檔、出 cwd、讀 .env 先在工具層擋掉。
    原生 read 規則管不到 bash 的 cat，所以沙箱與 audit 照留，這層只是提早擋。
    ponytail: 只處理純 JSON 的 opencode.json（plugin、opencode.jsonc 不帶）；要帶再擴充。"""
    src = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "opencode", "opencode.json")
    try:
        cfg = json.load(open(src))
    except (OSError, ValueError):
        cfg = {}
    cfg.pop("mcp", None)
    cfg["provider"] = {k: v for k, v in (cfg.get("provider") or {}).items() if "{file:" not in json.dumps(v)}
    cfg["permission"] = {"edit": "deny", "external_directory": "deny", "webfetch": "deny",
                         "read": {"*": "allow", "*.env": "deny", "*.env.*": "deny"}}
    home = tempfile.mkdtemp(prefix="quick-cfg-")
    os.makedirs(os.path.join(home, "opencode"))
    with open(os.path.join(home, "opencode", "opencode.json"), "w") as f:
        json.dump(cfg, f)
    return dict(os.environ, XDG_CONFIG_HOME=home)


def run(model, cwd, q, prefix, env=None):
    try:
        p = subprocess.run(prefix + [OC, "run", "-m", model, "--agent", "plan", "--dir", cwd, "--format", "json", ASK.format(q=q)],
                           capture_output=True, text=True, timeout=TIMEOUT, stdin=subprocess.DEVNULL, env=env)
    except subprocess.TimeoutExpired:
        return None, "timeout"
    if p.returncode != 0:
        print("quick: runner 失敗：" + p.stderr.strip()[:500], file=sys.stderr)
        return None, f"rc={p.returncode}"
    ev = []
    for ln in p.stdout.splitlines():
        try:
            ev.append(json.loads(ln))
        except ValueError:
            pass
    return ev, f"rc={p.returncode}"


def selftest():
    ev = lambda tool, **inp: {"type": "tool_use", "part": {"tool": tool, "state": {"input": inp}}}
    assert audit([ev("read", filePath="/x"), ev("bash", command="grep -n foo a.txt 2>/dev/null | head")]) == []
    assert audit([ev("bash", command="git -C /r log --oneline -3")]) == []
    assert audit([ev("bash", command="echo 'a > b'")]) == []
    assert audit([ev("write", filePath="/x")]) == ["write /x"]
    assert audit([ev("bash", command="ls; rm -f a")]) and audit([ev("bash", command="echo hi > out.txt")])
    assert audit([ev("bash", command="git -C /r commit -m x")]) and audit([ev("bash", command="sed -i '' s/a/b/ f")])
    assert PII.search("寄給 a.b@" + "c.com") and PII.search("0912-345-678") and not PII.search("PID 12345 port 8799")
    assert answer([{"type": "text", "part": {"text": "結論"}}, ev("read")]) == "結論"
    print("quick selftest ok")


def main(argv):
    if argv == ["--selftest"]:
        selftest()
        return 0
    push = bool(argv) and argv[0] == "--push"  # 11-07：答案交 brief-answer 寫成秘書口吻直送 Telegram
    argv = argv[1:] if push else argv
    if len(argv) < 1 or not argv[0].startswith("/") or not os.path.isdir(argv[0]):
        print(__doc__.split("\n")[1], file=sys.stderr)
        return 2
    cwd, q = argv[0], " ".join(argv[1:]).strip() or sys.stdin.read().strip()
    if not q:
        print("沒有問題內容", file=sys.stderr)
        return 2
    if sensitive_cwd(cwd):
        print("quick: cwd 位於敏感路徑，不送外部模型", file=sys.stderr)
        return 4
    if PII.search(q):
        print("問題含 PII，不送外部模型；呼叫端自己查", file=sys.stderr)
        return 4
    if not shutil.which(OC):
        print(f"quick: 找不到 {OC}（opencode 沒裝），改派 dispatcher", file=sys.stderr)
        return 6
    if os.environ.get("MYTHOS_TEST_SANDBOX") and not os.path.realpath(shutil.which(OC)).startswith(
            os.path.realpath(os.environ["MYTHOS_TEST_SANDBOX"]) + os.sep):
        print("測試模式拒跑真 runner", file=sys.stderr)
        return 97
    prefix = sandbox_prefix(cwd)
    env = clean_config_env() if prefix else None
    ms = models()
    if not ms:
        print("quick: 取不到免費模型清單（bin/free-models 失敗），不送出", file=sys.stderr)
        return 5
    request_stage("queued")
    request_stage("worker-start")
    for m in ms:
        ev, why = run(m, cwd, q, prefix, env)
        if ev is None:
            print(f"quick: {m} {why}，換下一個", file=sys.stderr)
            continue
        bad = audit(ev)
        if bad:
            print(f"quick: {m} 越界，答案作廢：{'；'.join(bad[:5])}", file=sys.stderr)
            return 3
        a = answer(ev)
        if a:
            brc = subprocess.run([BRIEF, "--kind", "quick", "--q", q], input=a, text=True).returncode if push else None
            if brc == 0:
                print("已直送使用者（秘書口吻），不用再 reply。")
                return 0
            if brc == 8:  # tg-send 結果不明：可能已送，Router 再轉述會重複（11-07 Codex P0）
                print("已直送使用者（送出結果不明，可能已到），不用再 reply。")
                return 0
            print(f"[quick {m}]\n{a}")
            return 0
        print(f"quick: {m} 沒有答案（{why}），換下一個", file=sys.stderr)
    print("quick: 全部模型失敗", file=sys.stderr)
    return 5


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
