#!/usr/bin/env bash
set -u

MYTHOS_DIR="${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
TMUX_BIN="${TMUX_BIN:-tmux}"
DCQ="${DCQ_BIN:-$(command -v dcq || echo "$HOME/.local/bin/dcq")}"
TSV="$MYTHOS_DIR/state/dispatch-jobs.tsv"
EVENTS_FILE="$MYTHOS_DIR/state/events.jsonl"
NODE_BIN="${NODE_BIN:-node}"
. "$(cd "$(dirname "$0")" && pwd)/lib-ledger.sh"

id="${1:-}"
if [ -z "$id" ]; then
  echo "用法：bin/dispatch-cancel <id>" >&2
  exit 2
fi
# backend 以 ledger 為準（D），ledger 沒有舊列就退回 id 前綴
row="$(awk -F'\t' -v id="$id" '$1 == id { print; exit }' "$TSV" 2>/dev/null | ledger_fields)"
backend="$(printf '%s' "$row" | cut -f8)"
case "$backend" in
  deep|dcq|bg|bg-hard|hermes) ;;
  *) case "$id" in deep-*) backend=deep ;; bg-*) backend=bg ;; *) backend=dcq ;; esac ;;
esac

# 取消後撤銷該票未 ACK 的事件（標 cancelled:true，dispatch-watch 的 pending_events 會排除）
mark_events() {
  [ -f "$EVENTS_FILE" ] || return 0
  local ids
  ids="$(jq -r --arg j "$id" 'select(.job_id==$j and .acked_at == null) | .event_id' "$EVENTS_FILE" 2>/dev/null)" || return 1
  [ -n "$ids" ] || return 0
  while IFS= read -r eid; do
    # 呼叫端（mark_cancelled）已持 ledger 鎖：ledger_events 看到已持鎖就直接寫（events 跟 ledger 同一把鎖）
    [ -n "$eid" ] && ledger_events set "$EVENTS_FILE" "$eid" '{"cancelled":true}' >/dev/null
  done <<< "$ids"
}

mark_cancelled() { # [只在持鎖時 status 仍等於此值才改，否則回 2]
  [ -f "$TSV" ] || return 0
  ledger_lock || { echo "拿不到 ledger 鎖" >&2; return 1; }
  local rc=0 tmp want="${1:-}"
  if [ -n "$want" ] && [ "$(awk -F'\t' -v id="$id" '$1 == id { print $5; exit }' "$TSV")" != "$want" ]; then
    ledger_unlock; return 2
  fi
  tmp="$(mktemp "${TMPDIR:-/tmp}/dispatch-cancel.XXXXXX")" || { ledger_unlock; return 1; }
  # 舊列不改寫：只有這張票被改成 cancelled，其餘原樣
  awk -F'\t' -v id="$id" 'BEGIN{OFS="\t"} $1==id {$5="cancelled"; if (NF<8) NF=8} {print}' "$TSV" > "$tmp" \
    && mv "$tmp" "$TSV" && mark_events || rc=1
  [ "$rc" = 0 ] || rm -f "$tmp"
  ledger_unlock
  return "$rc"
}

# queued 票（C3）：還沒啟動 runner、沒有 handle。持鎖確認仍是 queued 才標 cancelled：
# dispatch-watch 拉起 queued 也在同一把鎖內改 pending，所以這裡改成 cancelled 後它就不會再啟動。
# 持鎖時已不是 queued（剛被拉起）→ 往下走一般 deep 取消（看 handle）。
if [ "$(printf '%s' "$row" | cut -f5)" = queued ]; then
  mark_cancelled queued
  case $? in
    0) exit 0 ;;
    2) ;;
    *) echo "拿不到 ledger 鎖或寫檔失敗：${id}" >&2; exit 1 ;;
  esac
fi

fail_ledger() {
  echo "後端已取消：${id}；ledger 未更新（$1）：請稍後重跑 bin/dispatch-cancel $id 或手動確認" >&2
  exit 1
}

if [ "$backend" = dcq ]; then
  "$DCQ" cancel "$id" || { echo "dcq cancel 失敗：$id" >&2; exit 1; }
  mark_cancelled || fail_ledger "拿不到鎖或寫檔失敗"
  exit 0
fi

# hermes（11-08b dsh 差距 #2）：worker 是 dispatch-bg 起的 detached subshell＋hermes，pid 在 state/bg/<sid>.pid（subshell 的 pid）。
# 先持鎖確認還是 pending 並標 cancelled（之後 dispatch-watch 不會 deliver），再殺整個行程樹：先收集後代、TERM 全部，
# 1 秒後還活著的補 KILL（參考 dsh background.ts:159-164 的清程序樹）。已不是 pending＝已收尾，不動、exit 0。
if [ "$backend" = hermes ]; then
  sid="${id#bg-}"
  case "$sid" in ''|*[!0-9a-f]*) echo "id 取不出 hermes sid：$id" >&2; exit 1 ;; esac
  mark_cancelled pending
  case $? in
    0) ;;
    2) echo "不是進行中，不用取消：$id" >&2; exit 0 ;;
    *) echo "拿不到 ledger 鎖或寫檔失敗：${id}" >&2; exit 1 ;;
  esac
  hp="$(tr -d '[:space:]' < "$MYTHOS_DIR/state/bg/$sid.pid" 2>/dev/null)"
  case "$hp" in ''|*[!0-9]*) echo "hermes 沒有 pid 檔，ledger 已標 cancelled：$id" >&2; exit 0 ;; esac
  tree_pids() { local c; echo "$1"; for c in $(pgrep -P "$1" 2>/dev/null); do tree_pids "$c"; done; }
  all="$(tree_pids "$hp")"
  for p in $all; do kill -TERM "$p" 2>/dev/null; done
  sleep 1
  for p in $all; do kill -0 "$p" 2>/dev/null && kill -KILL "$p" 2>/dev/null; done
  exit 0
fi

# bg／bg-hard：worker 是獨立 claude session，只能 claude stop <短id>。停不掉就不標 cancelled（下輪 watch 照舊回報）。
if [ "$backend" = bg ] || [ "$backend" = bg-hard ]; then
  sid="${id#bg-}"
  # 測試守門（F1）：sandbox 非空時 claude 必須也在 sandbox 裡
  if [ -n "${MYTHOS_TEST_SANDBOX:-}" ]; then
    case "${CLAUDE_BIN:-claude}" in "$MYTHOS_TEST_SANDBOX"/*) ;; *) echo "測試模式拒跑真 runner" >&2; exit 97 ;; esac
  fi
  case "$sid" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *) echo "id 取不出短 session id：$id" >&2; exit 1 ;;
  esac
  "${CLAUDE_BIN:-claude}" stop "$sid" || { echo "claude stop 失敗，未標 cancelled：$sid" >&2; exit 1; }
  mark_cancelled || fail_ledger "拿不到鎖或寫檔失敗"
  exit 0
fi

# deep 只用 handle 精確取消（P1，11-04）：dispatch-deep-run 啟動時寫 state/deep/<id>.handle。
# 沒有 handle 就拒絕：舊版用工單內容／時間挑「最新候選」，內容相同的兩張票會殺錯（fix 11653 同類）。
handle="$MYTHOS_DIR/state/deep/$id.handle"
if [ ! -s "$handle" ]; then
  echo "沒有 handle，拒絕猜：$handle 不存在；用 $TMUX_BIN -L deep ls 確認後手動處理" >&2
  exit 1
fi
hget() { awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$handle"; }
pid="$(hget pid)"; deep_pid="$(hget deep_pid)"; session="$(hget session)"
case "$pid" in *[!0-9]*) pid='' ;; esac
case "$deep_pid" in *[!0-9]*) deep_pid='' ;; esac

# pid 會被別的程序重用（票跑完 handle 還留著）：現存程序的本輪 lstart 要與 handle 記的一致才動手。
# handle 啟動那一刻寫的行程必然還在，所以 lstart 沒抓到也是失配，不送訊號、不收集它的子程序。
# lstart 與 dispatch-deep-run 寫入時同一個 ps 格式，逐字比對。
identity_ok() { # pid handle 裡記的 start
  local cur
  cur="$(ps -o lstart= -p "$1" 2>/dev/null)"
  [ -n "$2" ] && [ -n "$cur" ] && [ "$2" = "$cur" ]
}
# 過期 handle（正式 runner 一定同時有 pid 與 session）：任一身分不符就整張拒絕，不碰 tmux／ledger／事件
if [ -n "$pid" ] && ! identity_ok "$pid" "$(hget pid_start)"; then
  echo "身分不符，不送訊號：$pid" >&2
  exit 1
fi
if [ -n "$deep_pid" ] && ! identity_ok "$deep_pid" "$(hget deep_pid_start)"; then
  echo "身分不符，不送訊號：$deep_pid" >&2
  exit 1
fi
case "$session" in deep-*) case "$session" in *[!A-Za-z0-9-]*) session='' ;; esac ;; *) session='' ;; esac
# pid 都判空又沒有 session 可精確殺＝無從取消，不動 ledger
if [ -z "$pid" ] && [ -z "$deep_pid" ] && [ -z "$session" ]; then
  echo "取消無效：pid／deep_pid 身分不符或 handle 沒記 start，也沒有 session：$handle" >&2
  exit 1
fi

# session 還沒記進 handle（剛派出）：只認名字結尾恰好是 -<deep_pid> 的那一個，且 deep-run 還活著
if [ -z "$session" ] && [ -n "$deep_pid" ] && kill -0 "$deep_pid" 2>/dev/null; then
  session="$("$TMUX_BIN" -L deep ls -F '#{session_name}' 2>/dev/null | grep -E "^deep-[0-9]+-${deep_pid}\$" | head -1)" || session=''
fi

# 先收集子行程再殺 runner（runner 死後子行程換父，-P 就找不到）
kids=''
[ -n "$pid" ] && kids="$(pgrep -P "$pid" 2>/dev/null | tr '\n' ' ')"
[ -n "$pid" ] && kill "$pid" 2>/dev/null
[ -n "$deep_pid" ] && kill "$deep_pid" 2>/dev/null
for k in $kids; do kill "$k" 2>/dev/null; done

if [ -n "$session" ]; then
  "$TMUX_BIN" -L deep kill-session -t "=$session" 2>/dev/null || true
else
  echo "警告：handle 沒有 session、也找不到 deep_pid 對應的 session，只殺程序、不動 tmux（用 $TMUX_BIN -L deep ls 確認）" >&2
fi

printf '%s\n' 130 > "$MYTHOS_DIR/state/deep/$id.rc" || fail_ledger "寫 rc 失敗"
mark_cancelled || fail_ledger "拿不到鎖或寫檔失敗"

exit 0
