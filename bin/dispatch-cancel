#!/usr/bin/env bash
set -u

MYTHOS_DIR="${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
TMUX_BIN="${TMUX_BIN:-tmux}"
DCQ="${DCQ_BIN:-$(command -v dcq || echo "$HOME/.local/bin/dcq")}"
DEEP_TASK_DIR="${DEEP_TASK_DIR:-$HOME/.deepclaude/work/.deep}"
TSV="$MYTHOS_DIR/state/dispatch-jobs.tsv"
EVENTS_FILE="$MYTHOS_DIR/state/events.jsonl"
LIB_EVENTS="$(cd "$(dirname "$0")" && pwd)/lib-events.mjs"
NODE_BIN="${NODE_BIN:-node}"
. "$(cd "$(dirname "$0")" && pwd)/lib-ledger.sh"

id="${1:-}"
if [ -z "$id" ]; then
  echo "用法：bin/dispatch-cancel <id>" >&2
  exit 2
fi
# backend 以 ledger 為準（D），ledger 沒有舊列就退回 id 前綴
row="$(awk -F'\t' -v id="$id" '$1 == id { print; exit }' "$TSV" 2>/dev/null | ledger_fields)"
backend="$(printf '%s' "$row" | cut -f8)"
case "$backend" in
  deep|dcq) ;;
  *) case "$id" in deep-*) backend=deep ;; *) backend=dcq ;; esac ;;
esac

# 取消後撤銷該票未 ACK 的事件（標 cancelled:true，dispatch-watch 的 pending_events 會排除）
mark_events() {
  [ -f "$EVENTS_FILE" ] || return 0
  local ids
  ids="$(jq -r --arg j "$id" 'select(.job_id==$j and .acked_at == null) | .event_id' "$EVENTS_FILE" 2>/dev/null)" || return 1
  [ -n "$ids" ] || return 0
  while IFS= read -r eid; do
    [ -n "$eid" ] && "$NODE_BIN" "$LIB_EVENTS" set "$EVENTS_FILE" "$eid" '{"cancelled":true}' >/dev/null
  done <<< "$ids"
}

mark_cancelled() {
  [ -f "$TSV" ] || return 0
  ledger_lock || { echo "拿不到 ledger 鎖" >&2; return 1; }
  local rc=0
  tmp="$(mktemp "${TMPDIR:-/tmp}/dispatch-cancel.XXXXXX")" || { ledger_unlock; return 1; }
  # 舊列不改寫：只有這張票被改成 cancelled，其餘原樣
  awk -F'\t' -v id="$id" 'BEGIN{OFS="\t"} $1==id {$5="cancelled"; if (NF<8) NF=8} {print}' "$TSV" > "$tmp" \
    && mv "$tmp" "$TSV" && mark_events || rc=1
  [ "$rc" = 0 ] || rm -f "$tmp"
  ledger_unlock
  return "$rc"
}

fail_ledger() {
  echo "後端已取消：${id}；ledger 未更新（$1）：請稍後重跑 bin/dispatch-cancel $id 或手動確認" >&2
  exit 1
}

if [ "$backend" = dcq ]; then
  "$DCQ" cancel "$id" || { echo "dcq cancel 失敗：$id" >&2; exit 1; }
  mark_cancelled || fail_ledger "拿不到鎖或寫檔失敗"
  exit 0
fi

pidf="$MYTHOS_DIR/state/deep/$id.pid"
if [ -f "$pidf" ]; then
  pid="$(tr -d '[:space:]' < "$pidf")"
  if [ -n "$pid" ]; then
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
  fi
fi

# 找 EPOCH：.deep 下比 .pid 新的 *-task.md，內容與工單相同
epoch=""
task_path="$(awk -F'\t' -v id="$id" '$1 == id { print $3; exit }' "$TSV" 2>/dev/null)"
if [ -d "$DEEP_TASK_DIR" ]; then
  pid_mtime=0
  if [ -f "$pidf" ]; then pid_mtime="$(stat -f %m "$pidf" 2>/dev/null || stat -c %Y "$pidf" 2>/dev/null)"; fi
  : "${pid_mtime:=0}"
  # 候選：*-task.md，mtime > pid_mtime，內容等於 task 檔
  best=""
  best_mtime=0
  for cand in "$DEEP_TASK_DIR"/*-task.md; do
    [ -f "$cand" ] || continue
    cmtime="$(stat -f %m "$cand" 2>/dev/null || stat -c %Y "$cand" 2>/dev/null)"
    : "${cmtime:=0}"
    [ "$cmtime" -gt "$pid_mtime" ] 2>/dev/null || continue
    if [ -n "$task_path" ] && [ -f "$task_path" ]; then
      if ! cmp -s "$cand" "$task_path" 2>/dev/null; then continue; fi
    fi
    if [ "$cmtime" -gt "$best_mtime" ]; then
      best="$cand"; best_mtime="$cmtime"
    fi
  done
  # 只認內容相符的 task 檔。舊版比對不到時 fallback 取「比 pid 新的最新 task」，
  # 並行時那是別張票（11-03 取消 r1 誤殺 v2，fix 11653）；工單派後被改過也會比對不到，寧可只殺程序
  if [ -n "$best" ]; then
    epoch="$(basename "$best")"
    epoch="${epoch%-task.md}"
  fi
fi

if [ -n "$epoch" ]; then
  "$TMUX_BIN" -L deep kill-session -t "deep-$epoch" 2>/dev/null || true
else
  echo "警告：找不到內容相符的 task 檔，只殺程序、不動 tmux（用 $TMUX_BIN -L deep ls 確認後再處理）" >&2
fi

printf '%s\n' 130 > "$MYTHOS_DIR/state/deep/$id.rc" || fail_ledger "寫 rc 失敗"
mark_cancelled || fail_ledger "拿不到鎖或寫檔失敗"

exit 0
