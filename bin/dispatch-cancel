#!/usr/bin/env bash
set -u

MYTHOS_DIR="${MYTHOS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
TMUX_BIN="${TMUX_BIN:-tmux}"
DCQ="${DCQ_BIN:-$(command -v dcq || echo "$HOME/.local/bin/dcq")}"
TSV="$MYTHOS_DIR/state/dispatch-jobs.tsv"
EVENTS_FILE="$MYTHOS_DIR/state/events.jsonl"
NODE_BIN="${NODE_BIN:-node}"
. "$(cd "$(dirname "$0")" && pwd)/lib-ledger.sh"

id="${1:-}"
if [ -z "$id" ]; then
  echo "用法：bin/dispatch-cancel <id>" >&2
  exit 2
fi
# backend 以 ledger 為準（D），ledger 沒有舊列就退回 id 前綴
row="$(awk -F'\t' -v id="$id" '$1 == id { print; exit }' "$TSV" 2>/dev/null | ledger_fields)"
backend="$(printf '%s' "$row" | cut -f8)"
case "$backend" in
  deep|dcq) ;;
  *) case "$id" in deep-*) backend=deep ;; *) backend=dcq ;; esac ;;
esac

# 取消後撤銷該票未 ACK 的事件（標 cancelled:true，dispatch-watch 的 pending_events 會排除）
mark_events() {
  [ -f "$EVENTS_FILE" ] || return 0
  local ids
  ids="$(jq -r --arg j "$id" 'select(.job_id==$j and .acked_at == null) | .event_id' "$EVENTS_FILE" 2>/dev/null)" || return 1
  [ -n "$ids" ] || return 0
  while IFS= read -r eid; do
    # 呼叫端（mark_cancelled）已持 ledger 鎖：ledger_events 看到已持鎖就直接寫（events 跟 ledger 同一把鎖）
    [ -n "$eid" ] && ledger_events set "$EVENTS_FILE" "$eid" '{"cancelled":true}' >/dev/null
  done <<< "$ids"
}

mark_cancelled() {
  [ -f "$TSV" ] || return 0
  ledger_lock || { echo "拿不到 ledger 鎖" >&2; return 1; }
  local rc=0
  tmp="$(mktemp "${TMPDIR:-/tmp}/dispatch-cancel.XXXXXX")" || { ledger_unlock; return 1; }
  # 舊列不改寫：只有這張票被改成 cancelled，其餘原樣
  awk -F'\t' -v id="$id" 'BEGIN{OFS="\t"} $1==id {$5="cancelled"; if (NF<8) NF=8} {print}' "$TSV" > "$tmp" \
    && mv "$tmp" "$TSV" && mark_events || rc=1
  [ "$rc" = 0 ] || rm -f "$tmp"
  ledger_unlock
  return "$rc"
}

fail_ledger() {
  echo "後端已取消：${id}；ledger 未更新（$1）：請稍後重跑 bin/dispatch-cancel $id 或手動確認" >&2
  exit 1
}

if [ "$backend" = dcq ]; then
  "$DCQ" cancel "$id" || { echo "dcq cancel 失敗：$id" >&2; exit 1; }
  mark_cancelled || fail_ledger "拿不到鎖或寫檔失敗"
  exit 0
fi

# deep 只用 handle 精確取消（P1，11-04）：dispatch-deep-run 啟動時寫 state/deep/<id>.handle。
# 沒有 handle 就拒絕：舊版用工單內容／時間挑「最新候選」，內容相同的兩張票會殺錯（fix 11653 同類）。
handle="$MYTHOS_DIR/state/deep/$id.handle"
if [ ! -s "$handle" ]; then
  echo "沒有 handle，拒絕猜：$handle 不存在；用 $TMUX_BIN -L deep ls 確認後手動處理" >&2
  exit 1
fi
hget() { awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$handle"; }
pid="$(hget pid)"; deep_pid="$(hget deep_pid)"; session="$(hget session)"
case "$pid" in *[!0-9]*) pid='' ;; esac
case "$deep_pid" in *[!0-9]*) deep_pid='' ;; esac
case "$session" in deep-*) case "$session" in *[!A-Za-z0-9-]*) session='' ;; esac ;; *) session='' ;; esac

# session 還沒記進 handle（剛派出）：只認名字結尾恰好是 -<deep_pid> 的那一個，且 deep-run 還活著
if [ -z "$session" ] && [ -n "$deep_pid" ] && kill -0 "$deep_pid" 2>/dev/null; then
  session="$("$TMUX_BIN" -L deep ls -F '#{session_name}' 2>/dev/null | grep -E "^deep-[0-9]+-${deep_pid}\$" | head -1)" || session=''
fi

# 先收集子行程再殺 runner（runner 死後子行程換父，-P 就找不到）
kids=''
[ -n "$pid" ] && kids="$(pgrep -P "$pid" 2>/dev/null | tr '\n' ' ')"
[ -n "$pid" ] && kill "$pid" 2>/dev/null
[ -n "$deep_pid" ] && kill "$deep_pid" 2>/dev/null
for k in $kids; do kill "$k" 2>/dev/null; done

if [ -n "$session" ]; then
  "$TMUX_BIN" -L deep kill-session -t "=$session" 2>/dev/null || true
else
  echo "警告：handle 沒有 session、也找不到 deep_pid 對應的 session，只殺程序、不動 tmux（用 $TMUX_BIN -L deep ls 確認）" >&2
fi

printf '%s\n' 130 > "$MYTHOS_DIR/state/deep/$id.rc" || fail_ledger "寫 rc 失敗"
mark_cancelled || fail_ledger "拿不到鎖或寫檔失敗"

exit 0
