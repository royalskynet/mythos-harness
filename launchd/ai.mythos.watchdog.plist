<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>ai.mythos.watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__REPO__/bin/watchdog</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__REPO__/logs/watchdog.err.log</string>
	<key>StandardOutPath</key>
	<string>__REPO__/logs/watchdog.out.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
