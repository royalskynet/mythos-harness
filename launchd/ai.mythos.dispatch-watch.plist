<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>~</string>
		<key>PATH</key>
		<string>~/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>ai.mythos.dispatch-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>~/bots/mythos/bin/dispatch-watch</string>
	</array>
	<key>StandardErrorPath</key>
	<string>~/bots/mythos/logs/dispatch-watch.err.log</string>
	<key>StandardOutPath</key>
	<string>~/bots/mythos/logs/dispatch-watch.out.log</string>
	<key>StartInterval</key>
	<integer>120</integer>
</dict>
</plist>
