!/profiles/mythos/SOUL.md
!/profiles/mythos/config.yaml
!/profiles/mythos/distribution.yaml
!/profiles/mythos/path-guard.example.json
!/profiles/mythos/plugins/
/profiles/mythos/plugins/*
!/profiles/mythos/plugins/mythos-tools/
/profiles/mythos/plugins/mythos-tools/*
!/profiles/mythos/plugins/mythos-tools/__init__.py
!/profiles/mythos/plugins/mythos-tools/plugin.yaml
!/profiles/mythos/plugins/mythos-tools/test_recall.py
!/profiles/mythos/plugins/router-guard/
/profiles/mythos/plugins/router-guard/*
