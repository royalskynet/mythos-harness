!/profiles/mythos/plugins/router-guard/plugin.yaml
!/profiles/mythos/plugins/router-guard/test_guard.py
!/profiles/mythos/plugins/path-guard/
/profiles/mythos/plugins/path-guard/*
!/profiles/mythos/plugins/path-guard/__init__.py
!/profiles/mythos/plugins/path-guard/plugin.yaml
!/profiles/mythos/plugins/path-guard/test_guard.py
!/tests/
/tests/*
!/tests/test-genie-context.py
!/tests/test-plugin-bin-exec.sh
!/tests/test-recall-links.py
!/tests/test-claude-mem-local-patch.py
!/tests/test-delegation-background.sh
!/tests/test-session-retention.sh
